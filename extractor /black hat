--BLACK HAT
local HttpService = game:GetService("HttpService")
local genv = (getgenv and getgenv()) or _G

if genv.__BLACKHAT then return genv.__BLACKHAT end

local Findings, Seen, Buffer, Subs = {}, {}, {}, {}
local wrapped = setmetatable({}, { __mode = "k" })

local function emit(level, msg, data)
    local ev = { Level = level, Message = msg, Data = data }
    if #Subs == 0 then
        Buffer[#Buffer + 1] = ev
        if #Buffer > 200 then table.remove(Buffer, 1) end
        return
    end
    for _, cb in ipairs(Subs) do task.defer(function() pcall(cb, ev) end) end
end

local function report(kind, value, source, level, msg)
    local key = kind .. tostring(value)
    if Seen[key] then return end
    Seen[key] = true
    table.insert(Findings, { Type = kind, Value = value, Source = source, Time = os.time() })
    emit(level, msg, { Type = kind, Value = value, Source = source })
end

local function analyzeContent(text, source)
    if type(text) ~= "string" or #text < 5 then return end
    for url in string.gmatch(text, "https?://discord%.com/api/webhooks/[%d]+/[%w%-_]+") do
        report("Webhook", url, source, "WARN", string.format("[Black Hat] Webhook Detectado\n   Origen: %s\n   URL: %s", source, url))
    end
    for token in string.gmatch(text, "([a-zA-Z0-9_%-%.]+%.[a-zA-Z0-9_%-%.]+%.[a-zA-Z0-9_%-%.]+)") do
        if #token > 50 and token:find("%.") then
            local short_val = token:sub(1, 20) .. "..." .. token:sub(-10)
            report("API Token", token, source, "WARN", string.format("[Black Hat] Token API Detectado\n   Origen: %s\n   Valor: %s", source, short_val))
        end
    end
end

local function processRequest(source, url, body, headers)
    task.spawn(function()
        if type(url) == "string" then analyzeContent(url, source) end
        if type(body) == "string" then
            analyzeContent(body, source)
            pcall(function()
                local data = HttpService:JSONDecode(body)
                if type(data) == "table" then
                    for k, v in pairs(data) do
                        if type(k) == "string" and (k:lower():find("token") or k:lower():find("pass") or k:lower():find("key")) then
                            report("Credencial", k .. "=" .. tostring(v), source, "WARN", string.format("[Black Hat] Credencial Detectada\n   Origen: %s\n   Clave: %s", source, k))
                        end
                    end
                end
            end)
        end
        if type(headers) == "table" then
            for k, v in pairs(headers) do
                local lk = tostring(k):lower()
                if lk:find("auth") or lk:find("token") then
                    report("Header", k .. ": " .. tostring(v), source, "WARN", string.format("[Black Hat] Header Sensible\n   Origen: %s\n   Header: %s", source, k))
                end
            end
        end
    end)
end

local function wrapFunction(name, orig)
    return newcclosure(function(opts, ...)
        pcall(function()
            if type(opts) == "table" then
                processRequest(name, opts.Url or opts.url, opts.Body or opts.body, opts.Headers or opts.headers)
            end
        end)
        return orig(opts, ...)
    end)
end

for _, name in ipairs({"request", "http_request", "syn.request", "http.request"}) do
    local f = genv[name]
    if type(f) == "function" and not wrapped[f] then
        genv[name] = wrapFunction(name, f)
        wrapped[genv[name]] = true
    end
end

local HTTP_METHODS = { HttpGet = true, HttpGetAsync = true, HttpPost = true, HttpPostAsync = true, GetAsync = true, PostAsync = true, RequestAsync = true }

if hookmetamethod then
    pcall(function()
        local oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if HTTP_METHODS[method] and (self == game or self == HttpService) then
                local args = {...}
                local url, body, headers
                if method == "RequestAsync" then
                    local req = args[1]
                    if type(req) == "table" then url, body, headers = req.Url, req.Body, req.Headers end
                elseif method:find("Post") then url, body = args[1], args[2]
                else url = args[1] end
                processRequest("game:" .. method, url, body, headers)
            end
            return oldNamecall(self, ...)
        end))
    end)
end

local BlackHat = {
    Version = "1.5",
    OnLog = function(cb)
        if type(cb) ~= "function" then return function() end end
        table.insert(Subs, cb)
        if #Buffer > 0 then
            local pending = Buffer
            Buffer = {}
            for _, ev in ipairs(pending) do task.defer(function() pcall(cb, ev) end) end
        end
        return function() end
    end,
    GetFindings = function() return Findings end,
    Clear = function() Findings, Seen, Buffer = {}, {}, {} end,
}

genv.__BLACKHAT = BlackHat
return BlackHat
