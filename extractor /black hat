--black hat
local genv = (getgenv and getgenv()) or _G
if genv.__BLACKHAT then return genv.__BLACKHAT end

local lower, find, sub, match, gmatch, gsub, format, char, byte =
    string.lower, string.find, string.sub, string.match, string.gmatch, string.gsub, string.format, string.char, string.byte
local pack = table.pack
local newcc = newcclosure or function(f) return f end

local function dbg(...)
    if genv.__BLACKHAT_DEBUG then pcall(warn, "[BlackHat]", ...) end
end

local function safe(f, ...)
    local ok, a, b = pcall(f, ...)
    if not ok then dbg(a) return nil end
    return a, b
end

local Findings, Seen, Buffer, Subs = {}, {}, {}, {}
local wrapped = setmetatable({}, { __mode = "k" })

local HttpService = safe(function() return game:GetService("HttpService") end)
local jdec = safe(function() return HttpService.JSONDecode end)
local IDENTS = {}
safe(function()
    local lp = game:GetService("Players").LocalPlayer
    for _, v in ipairs({ lp.Name, lp.DisplayName, tostring(lp.UserId) }) do
        v = lower(tostring(v))
        if #v >= 5 then IDENTS[#IDENTS + 1] = v end
    end
end)

local function dispatch(cb, ev)
    local run = function() pcall(cb, ev) end
    if task and task.defer then task.defer(run) else run() end
end

local function emit(level, msg, data)
    local ev = { Level = level, Message = msg, Data = data }
    if #Subs == 0 then
        Buffer[#Buffer + 1] = ev
        if #Buffer > 200 then table.remove(Buffer, 1) end
        return
    end
    for _, cb in ipairs(Subs) do dispatch(cb, ev) end
end

local function report(kind, value, source, level, msg, data)
    local key = kind .. value
    if Seen[key] then return end
    Seen[key] = true
    Findings[#Findings + 1] = { Type = kind, Value = value, Source = source, Time = os.time() }
    emit(level, msg, data)
end

local SENS = {}
for w in gmatch("token key api_key apikey authorization bearer password passwd session sessionid auth secret cookie set_cookie access_token refresh_token", "%S+") do
    SENS[w] = true
end
local SUFFIX = { "_token", "_key", "_secret", "_authorization", "_password", "_cookie", "_session" }

local function isSens(k)
    k = gsub(lower(tostring(k)), "[%s%-]", "_")
    if SENS[k] then return true end
    for _, s in ipairs(SUFFIX) do
        if sub(k, -#s) == s then return true end
    end
    return false
end

local function urldecode(s)
    s = gsub(s, "%+", " ")
    return (gsub(s, "%%(%x%x)", function(h) return char(tonumber(h, 16)) end))
end

local B64 = {}
do
    local al = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i = 1, #al do B64[byte(al, i)] = i - 1 end
    B64[45], B64[95] = 62, 63
end

local function b64decode(s)
    local out, buf, bits = {}, 0, 0
    for i = 1, #s do
        local v = B64[byte(s, i)]
        if v then
            buf, bits = buf * 64 + v, bits + 6
            if bits >= 8 then
                bits = bits - 8
                local p = 2 ^ bits
                out[#out + 1] = char(math.floor(buf / p) % 256)
                buf = buf % p
            end
        end
    end
    return table.concat(out)
end

local function printable(s)
    local n, ok = math.min(#s, 120), 0
    for i = 1, n do
        local b = byte(s, i)
        if (b >= 32 and b <= 126) or b == 9 or b == 10 or b == 13 then ok = ok + 1 end
    end
    return n > 0 and ok / n >= 0.9
end

local function cred(k, v, source)
    v = gsub(tostring(v), "^%a+%s+", "")
    if #v < 3 then return end
    report("credential", tostring(k) .. "=" .. v, source, "WARN",
        format("[BlackHat] Credencial detectada: %s=%s...", tostring(k), sub(v, 1, 6)),
        { Type = "credential", Key = tostring(k), Value = v, Source = source })
end

local function scanText(text, source)
    if type(text) ~= "string" or text == "" then return end
    local t = safe(urldecode, text) or text
    for _, dom in ipairs({ "discord%.com", "discordapp%.com" }) do
        for url in gmatch(t, "https?://[%w%.]*" .. dom .. "/api/[%w/]-webhooks/%d+/[%w_%-]+") do
            local host, id = match(url, "https?://([^/]+)/api/[%w/]-webhooks/(%d+)/")
            report("webhook", url, source, "WARN",
                format("[BlackHat] Webhook capturado: %s/%s", host or "?", sub(id or "", 1, 8)),
                { Type = "webhook", Url = url, Source = source })
        end
    end
    local ck = match(t, "(_|WARNING:%-DO%-NOT%-SHARE[^;%s\"']+)")
    if ck then
        report("cookie", ck, source, "ERR", "[BlackHat] Cookie .ROBLOSECURITY detectada: " .. sub(ck, 1, 6) .. "...",
            { Type = "cookie", Value = ck, Source = source })
    end
end

local function scanUrl(url, source)
    scanText(url, source)
    local u, p = match(url, "^%a[%w+.-]*://([^/@%s:]+):([^/@%s]+)@")
    if u then cred("userinfo:" .. u, p, source) end
    local qs = match(url, "%?([^#]*)")
    if qs then
        for k, v in gmatch(qs, "([^&=]+)=([^&]*)") do
            if isSens(k) then cred(k, safe(urldecode, v) or v, source) end
        end
    end
end

local function scanHeaders(h, source)
    if type(h) ~= "table" then return end
    for k, v in pairs(h) do
        if type(v) == "string" or type(v) == "number" then
            if isSens(k) then cred(k, v, source) end
            scanText(tostring(v), source)
        end
    end
end

local function walk(t, source, lvl)
    if lvl > 3 then return end
    for k, v in pairs(t) do
        local tv = type(v)
        if tv == "table" then
            walk(v, source, lvl + 1)
        elseif tv == "string" or tv == "number" then
            if isSens(k) then cred(k, v, source) end
            if tv == "string" then scanText(v, source) end
        end
    end
end

local function scanBody(body, source, depth)
    depth = depth or 0
    if type(body) ~= "string" or body == "" then return end
    if #body > 200000 then body = sub(body, 1, 200000) end
    scanText(body, source)
    local data = jdec and safe(jdec, HttpService, body)
    if type(data) == "table" then
        walk(data, source, 1)
    else
        for k, v in gmatch(body, "([^&=\r\n{}\"]+)=([^&\r\n]*)") do
            if isSens(k) then cred(k, safe(urldecode, v) or v, source) end
        end
    end
    if depth < 2 then
        local n = 0
        for run in gmatch(body, "[%w%+/=_%-]+") do
            if #run >= 24 and n < 10 then
                n = n + 1
                local dec = safe(b64decode, run)
                if dec and #dec >= 8 and printable(dec) then scanBody(dec, source, depth + 1) end
            end
        end
    end
end

local function onRequest(source, url, body, headers)
    if type(url) == "string" then scanUrl(url, source) end
    scanBody(body, source)
    scanHeaders(headers, source)
    if #IDENTS > 0 then
        local blob = lower(sub((type(url) == "string" and url or "") .. (type(body) == "string" and body or ""), 1, 20000))
        for _, id in ipairs(IDENTS) do
            if find(blob, id, 1, true) then
                report("identity", id, source, "WARN",
                    format("[BlackHat] Identidad del jugador enviada via %s: %s...", source, sub(id, 1, 3)),
                    { Type = "identity", Value = id, Source = source })
            end
        end
    end
end

local function label(base)
    local c = safe(function() local s = getcallingscript and getcallingscript(); return s and tostring(s) end)
    return c and (base .. "@" .. c) or base
end

local function reqArgs(o)
    if type(o) ~= "table" then return end
    local function g(n) local v = o[n]; if v == nil then v = o[lower(n)] end; return v end
    return g("Url"), g("Body"), g("Headers")
end

local function safeSet(parent, key, value)
    if pcall(function() parent[key] = value end) and parent[key] == value then return true end
    if setreadonly then
        local ro = true
        if isreadonly then local ok, r = pcall(isreadonly, parent); ro = ok and r end
        pcall(setreadonly, parent, false)
        local ok = pcall(function() parent[key] = value end)
        if ro then pcall(setreadonly, parent, true) end
        return ok and parent[key] == value
    end
    return false
end

local function resolve(path)
    local cur, parent, last = genv, nil, nil
    for part in gmatch(path, "[^.]+") do
        if type(cur) ~= "table" then return end
        parent, last, cur = cur, part, cur[part]
    end
    return parent, last, cur
end

local function install(path, make)
    local parent, last, fn = resolve(path)
    if type(fn) ~= "function" or wrapped[fn] then return end
    local w = newcc(make(fn))
    if safeSet(parent, last, w) then wrapped[w] = true return end
    if hookfunction then
        local holder
        local ok, res = pcall(hookfunction, fn, newcc(make(function(...) return holder(...) end)))
        if ok and res then holder = res; wrapped[fn] = true return end
    end
    dbg("no se pudo envolver", path)
end

local function hookMeta(key, handler)
    local mt
    if getrawmetatable then
        local ok, r = pcall(getrawmetatable, game)
        if ok and type(r) == "table" then mt = r end
    end
    local ro = false
    if mt and isreadonly then local ok, r = pcall(isreadonly, mt); ro = ok and r == true end
    if ro and setreadonly then pcall(setreadonly, mt, false) end
    local old
    if hookmetamethod then
        local ok, res = pcall(hookmetamethod, game, key, handler)
        if ok then old = res end
    end
    if old == nil and mt then
        old = rawget(mt, key)
        if not pcall(function() mt[key] = handler end) then old = nil end
    end
    if ro and setreadonly then pcall(setreadonly, mt, true) end
    if old == nil then dbg("no se pudo hookear", key) end
    return old
end

for _, path in ipairs({ "request", "http_request", "httprequest", "syn.request", "http.request", "fluxus.request" }) do
    install(path, function(orig)
        return function(opts, ...)
            safe(function()
                local u, b, h = reqArgs(opts)
                onRequest(label(path), u, b, h)
            end)
            return orig(opts, ...)
        end
    end)
end

for _, path in ipairs({ "WebSocket.connect", "WebSocket.Connect", "syn.websocket.connect" }) do
    install(path, function(orig)
        return function(url, ...)
            safe(function() if type(url) == "string" then scanUrl(url, path) end end)
            local sock = orig(url, ...)
            safe(function()
                if type(sock) == "table" and type(sock.Send) == "function" and not wrapped[sock.Send] then
                    local send = sock.Send
                    local w = newcc(function(self, data, ...)
                        safe(scanBody, data, path .. ".Send")
                        return send(self, data, ...)
                    end)
                    wrapped[w] = true
                    sock.Send = w
                end
            end)
            return sock
        end
    end)
end

for _, path in ipairs({ "getrenv", "getsenv" }) do
    install(path, function(orig)
        return function(...)
            safe(function()
                local a = ...
                report("env", path .. ":" .. tostring(a), path, "INFO", "[BlackHat] Acceso a entorno via " .. path, { Type = "env", Source = path })
            end)
            return orig(...)
        end
    end)
end

local HTTP_M = { HttpGet = 1, HttpGetAsync = 1, HttpPost = 1, HttpPostAsync = 1, GetAsync = 1, PostAsync = 1, RequestAsync = 1 }

local function extract(m, a)
    if m == "RequestAsync" then return reqArgs(a[1]) end
    if find(m, "Post") then return a[1], a[2], type(a[5]) == "table" and a[5] or nil end
    return a[1], nil, type(a[3]) == "table" and a[3] or nil
end

local function sniff(self, m, a)
    safe(function()
        local u, b, h = extract(m, a)
        onRequest(label((self == game and "game:" or "HttpService:") .. m), u, b, h)
    end)
end

local function lookup(m, v)
    report("lookup", tostring(v), "Players:" .. m, "INFO",
        format("[BlackHat] Resolucion de jugador (%s): %s", m, tostring(v)),
        { Type = "lookup", Value = tostring(v), Source = "Players:" .. m })
end

local oldNc, oldIdx
oldNc = hookMeta("__namecall", newcc(function(self, ...)
    local m = getnamecallmethod()
    if HTTP_M[m] and (self == game or self == HttpService) then
        sniff(self, m, pack(...))
    elseif m == "GetPlayerByUserId" or m == "GetUserIdFromNameAsync" then
        safe(lookup, m, (...))
    end
    if setnamecallmethod then setnamecallmethod(m) end
    if oldNc then return oldNc(self, ...) end
end))

oldIdx = hookMeta("__index", newcc(function(self, key)
    local v = oldIdx(self, key)
    if type(v) == "function" and HTTP_M[key] and (self == game or self == HttpService) then
        return newcc(function(s, ...)
            sniff(s, key, pack(...))
            return v(s, ...)
        end)
    end
    return v
end))

local BlackHat = {
    Version = "1.0",
    OnLog = function(cb)
        if type(cb) ~= "function" then return function() end end
        Subs[#Subs + 1] = cb
        if #Buffer > 0 then
            local pending = Buffer
            Buffer = {}
            for _, ev in ipairs(pending) do dispatch(cb, ev) end
        end
        return function()
            for i, f in ipairs(Subs) do
                if f == cb then table.remove(Subs, i) break end
            end
        end
    end,
    GetFindings = function()
        local out = {}
        for i, f in ipairs(Findings) do
            out[i] = { Type = f.Type, Value = f.Value, Source = f.Source, Time = f.Time }
        end
        return out
    end,
    Clear = function()
        Findings, Seen, Buffer = {}, {}, {}
    end,
}

genv.__BLACKHAT = BlackHat
return BlackHat
