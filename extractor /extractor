        for _, c in ipairs(CON_SCR:GetChildren()) do
            if c:IsA("Frame") then c:Destroy(); break end
        end
    else
        lineCounter = lineCounter + 1
    end
    local row = mk("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
        BackgroundTransparency=1, LayoutOrder=lineCounter+1, ZIndex=16}, CON_SCR)
    local textX = 0
