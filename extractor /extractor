--drag
local connections = {}
local dragging, dragStart, winStart = false, nil, nil
local resizing, activeHandle = false, nil
local resizeStart, resizeWinPos, resizeWinSize = nil, nil, nil
local function pointInGui(obj, px, py)
    if not obj or not obj.Parent then return false end
    local ap, as = obj.AbsolutePosition, obj.AbsoluteSize
    return px >= ap.X and px <= ap.X + as.X and py >= ap.Y and py <= ap.Y + as.Y
end
local function isOverUI(px, py)
    return pointInGui(CLOSE_BTN, px, py) or pointInGui(MINI_BTN, px, py)
        or pointInGui(INPUT_ROW, px, py) or pointInGui(INPUT, px, py)
        or pointInGui(RUN_BTN, px, py) or pointInGui(CON_SCR, px, py)
end
local function startDrag(pos) dragging = true; dragStart = pos; winStart = WIN.Position; TW(WIN_SCALE, TI_FAST, {Scale=1.01}) end
local function updateDrag(pos)
    if not dragging then return end
    local d = pos - dragStart
    local v = workspace.CurrentCamera.ViewportSize
    local nx = math.max(0, math.min(winStart.X.Offset + d.X, v.X - 100))
    local ny = math.max(0, math.min(winStart.Y.Offset + d.Y, v.Y - 40))
    WIN.Position = UDim2.new(0, nx, 0, ny)
end
local function stopDrag() dragging = false; dragStart = nil; winStart = nil; TW(WIN_SCALE, TI_SOFT, {Scale=1}) end
connections[#connections + 1] = TB.InputBegan:Connect(function(inp, gp)
    if gp or (inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch) then return end
    if isOverUI(inp.Position.X, inp.Position.Y) then return end
    startDrag(Vector2.new(inp.Position.X, inp.Position.Y))
end)
connections[#connections + 1] = UIS.InputChanged:Connect(function(inp)
    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(Vector2.new(inp.Position.X, inp.Position.Y))
    end
end)
connections[#connections + 1] = UIS.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        if dragging then stopDrag() end
        if resizing then
            resizing = false; activeHandle = nil; resizeStart = nil; resizeWinPos = nil; resizeWinSize = nil
            TW(WIN_SCALE, TI_SOFT, {Scale=1})
        end
    end
end)

--resize
local RESIZE_EDGE = SET.RESIZE_EDGE
local cornerHandles = {
    {name="TL", px=0, py=0, dx=-1, dy=-1}, {name="TR", px=1, py=0, dx=1, dy=-1},
    {name="BL", px=0, py=1, dx=-1, dy=1}, {name="BR", px=1, py=1, dx=1, dy=1},
}
for _, h in ipairs(cornerHandles) do
    local hf = mk("Frame", {Name="Rsz_"..h.name,
        Size=UDim2.new(0, RESIZE_EDGE, 0, RESIZE_EDGE),
        Position=UDim2.new(h.px, h.dx == 1 and -RESIZE_EDGE or 0, h.py, h.dy == 1 and -RESIZE_EDGE or 0),
        BackgroundTransparency=1, ZIndex=10, Active=true}, WIN)
    hf.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            local px, py = inp.Position.X, inp.Position.Y
            if pointInGui(CLOSE_BTN, px, py) or pointInGui(MINI_BTN, px, py) or pointInGui(TB, px, py) then return end
            activeHandle = h; resizing = true
            resizeStart = Vector2.new(inp.Position.X, inp.Position.Y)
            resizeWinPos = WIN.Position; resizeWinSize = WIN.Size
            TW(WIN_SCALE, TI_FAST, {Scale=1.015})
        end
    end)
end
local function updateResize(pos)
    if not resizing or not activeHandle then return end
    local d = pos - resizeStart
    local vp = workspace.CurrentCamera.ViewportSize
    local W, H = resizeWinSize.X.Offset, resizeWinSize.Y.Offset
    local PX, PY = resizeWinPos.X.Offset, resizeWinPos.Y.Offset
    local nW, nH, nPX, nPY = W, H, PX, PY
    if activeHandle.dx == 1 then nW = math.min(math.max(SET.MIN_W, W + d.X), vp.X - PX)
    elseif activeHandle.dx == -1 then
        local dw = math.min(d.X, W - SET.MIN_W); nW = W - dw; nPX = math.max(0, PX + dw)
    end
    if activeHandle.dy == 1 then nH = math.min(math.max(SET.MIN_H, H + d.Y), vp.Y - PY)
    elseif activeHandle.dy == -1 then
        local dh = math.min(d.Y, H - SET.MIN_H); nH = H - dh; nPY = math.max(0, PY + dh)
    end
    WIN.Size = UDim2.new(0, nW, 0, nH)
    WIN.Position = UDim2.new(0, nPX, 0, nPY)
end
connections[#connections + 1] = UIS.InputChanged:Connect(function(inp)
    if not resizing or not activeHandle then return end
    if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
        updateResize(Vector2.new(inp.Position.X, inp.Position.Y))
    end
end)

