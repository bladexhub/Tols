local BLACKLIST_ALLOW, BLACKLIST_BLACK = {}, {}
local function loadBlacklistRemote()
    local code = fetch(URL_BLACKLIST); if not code then return false end
    local fn = loadstring(code); if not fn then return false end
    local ok, tbl = pcall(fn)
    if not ok or type(tbl) ~= "table" then return false end
    if tbl.ALLOW then for _, p in ipairs(tbl.ALLOW) do BLACKLIST_ALLOW[tostring(p):lower()] = true end end
    if tbl.BLACK then for _, p in ipairs(tbl.BLACK) do BLACKLIST_BLACK[tostring(p):lower()] = true end end
    return true
end
