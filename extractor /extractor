--url
local function extractURL(input)
    if type(input) ~= "string" then return nil end
    input = input:match("^%s*(.-)%s*$")
    if input == "" then return nil end
    local u = input:match("^(https?://%S+)$"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et%s*%(?%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et%s*%(?%s*%[=*%[([^%]]+)%]=*%]"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et[Aa]sync%s*%(?%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("[Uu]rl%s*=%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("(https?://[^%s\"'%)%]]+)"); if u then return u end
    return nil
end

--checks
local function isLayer(code)
    if type(code) ~= "string" or #code < 150 then return false end
    if string.find(code, "^%-%- LuaGate") then return true end
    local p1 = string.find(code, "loadstring", 1, true)
    if p1 then local p2 = string.find(code, "HttpGet", p1, true); if p2 then return true end end
    if string.find(code, "HttpGetAsync", 1, true) then return true end
    if #code > 500 and string.find(code, "function", 1, true) then return true end
    return false
end
local function isLuarmor(code)
    if type(code) ~= "string" then return false end
    if string.find(code, "superflow_bytecode", 1, true) then return true end
    if string.find(code, "Luamor V4 bootstrapper", 1, true) then return true end
    if string.find(code, "_bsdata", 1, true) and string.find(code, "=", 1, true) then return true end
    return false
end

--exec
exec = function(input)
    if not input or input:match("^%s*$") then
        addLine("Error: sin URL. Pega un link del panel.", C.CON_ERR, "err", ICO.error)
        return
    end
    table.insert(history, 1, input)
    if #history > 60 then table.remove(history) end
    histIdx = 0

    local url = extractURL(input)
    if not url then
        addLine("Error: URL no válido.", C.CON_ERR, "err", ICO.error)
        return
    end

    task.spawn(function()
        -- Extraer el dominio de la URL para crear su carpeta única
        local parsedHost = url:match("^%a+://([^/%?#:]+)") or "desconocido"
        parsedHost = parsedHost:lower()

        --pipeline cfg (sistema Bladex)
        local DIR            = "Bladex/extract/" .. parsedHost
        local MODE           = "blacklist"
        local AUTO_BLACK     = false -- Desactivado para no bloquear nuevos enlaces
        local FAKE           = true
        local BYPASS_LOADER  = true
        local GRACE          = 20
        local PRINT          = true
        local PRINT_MIN      = 0.4
        local LOG_LIMIT      = 2000000
        local CACHE_LIMIT    = 4096
        local VFS            = false -- Desactivado para evitar el error State323 de Luarmor
        local LOADER_URL     = url
        local PERSIST        = DIR .. "/lista_negra.txt"
        local UNKNOWN_FILE   = DIR .. "/desconocidos.txt"

        pcall(makefolder, "Bladex")
        pcall(makefolder, "Bladex/extract")
        pcall(makefolder, DIR)
        local uid = string.format("%x", os.time())
        local function pathFor(n)
            return DIR .. "/" .. uid .. "-c" .. n .. ".lua"
        end

        local LUA_TOKENS = { "function", "local ", "return", "end ", "pcall" }

        --sets (parten de blacklist remota)
        local ALLOW, BLACK = {}, {}
        for k in pairs(BLACKLIST_ALLOW) do ALLOW[k] = true end
        for k in pairs(BLACKLIST_BLACK) do BLACK[k] = true end

        addLine("Lista negra: " .. (hasRemoteBL and "remota OK" or "fallback local")
            .. " | allow=" .. tostring(next(ALLOW) and "sí" or "no")
            .. " | black=" .. tostring(next(BLACK) and "sí" or "no"), C.CON_OK, "ok", ICO.check)

        --estado
        local layers, busy, n, seq = 0, false, 0, 0
        local loading, lastPrint, lsDepth = false, 0, 0
        local bypassUntil = 0
        local win, winT, dropped = 0, 0, 0
        local stats = { pass=0, block=0, unknown=0, dropped=0, padding=0 }
        local hCache, dCache, seen, unknowns = {}, {}, {}, {}
        local buf, pend, pendU = {}, {}, {}
        local bytes, target = 0, DIR .. "/log.txt"

        --hookfn
        local function hookfn(tbl, name, factory)
            if not tbl then return false end
            local f = tbl[name]
            if type(f) ~= "function" then return false end
            local ref = { f }
            local w = factory(function(...) return ref[1](...) end)
            if newcclosure then
                local ok, wc = pcall(newcclosure, w)
                if ok then w = wc end
            end
            if hookfunction then
                local ok, orig = pcall(hookfunction, f, w)
                if ok and type(orig) == "function" then
                    ref[1] = orig
                    return true
                end
            end
            ref[1] = f
            tbl[name] = w
            return true
        end

        local function stamp() return os.date("%H:%M:%S") end

        local function host(u)
            local h = u:match("^%a[%w+.%-]*://([^/%?#]+)") or u:match("^([^/%?#]+)")
            h = (h or ""):lower()
            if h:find(":", 1, true) then h = (h:gsub(":%d+$", "")) end
            return h
        end

        local function matchSet(h, set)
            if set[h] then return true end
            local i = 1
            while true do
                local d = h:find(".", i, true)
                if not d then return false end
                if set[h:sub(d + 1)] then return true end
                i = d + 1
            end
        end

        --compute
        local function compute(u)
            local h = hCache[u] or host(u)
            hCache[u] = h
            if matchSet(h, ALLOW) then return false end
            if matchSet(h, BLACK) then return true end
            if MODE == "all" then return true end

            -- Auto-blacklist desactivado
            if not AUTO_BLACK then
                if not unknowns[h] then unknowns[h] = true; pendU[#pendU + 1] = h end
                return false
            end
            BLACK[h] = true
            pend[#pend + 1] = h
            return true
        end

        --flush (PERSIST + UNKNOWN + LOG_LIMIT)
        local writing = false
        local function flush()
            if writing or (#buf == 0 and #pend == 0 and #pendU == 0) then return end
            writing = true
            local s, p, u = table.concat(buf), nil, nil
            if #pend > 0 then p = table.concat(pend, "\n") .. "\n" end
            if #pendU > 0 then u = table.concat(pendU, "\n") .. "\n" end
            table.clear(buf); table.clear(pend); table.clear(pendU)
            pcall(function()
                if p then appendfile(PERSIST, p) end
                if u then appendfile(UNKNOWN_FILE, u) end
                if s ~= "" and appendfile then
                    appendfile(target, s)
                    bytes = bytes + #s
                    if bytes > LOG_LIMIT then
                        n = n + 1
                        target = DIR .. "/log_" .. n .. ".txt"
                        bytes = 0
                    end
                end
            end)
            writing = false
        end

        --log
        local function log(line)
            local now = os.clock()
            if now - winT >= 1 then winT, win = now, 0 end
            win = win + 1
            if win > 500 then dropped = dropped + 1; return end
            buf[#buf + 1] = stamp() .. " " .. line .. "\n"
            addLine(line, C.CON_SYS, "info", ICO.info)
            if PRINT and not loading and (now - lastPrint >= PRINT_MIN) then
                lastPrint = now
                print("[HOOK] " .. line)
            end
            if #buf >= 128 then flush() end
        end

        --net
        local function net(kind, u, body)
            if u == nil or busy then return false end
            local full = tostring(u)
            if full:match("^%s*$") then return false end
            busy = true
            local k = full:match("^[^%?]+") or full
            local cut = dCache[k]
            if cut == nil then
                cut = compute(full)
                if #dCache > CACHE_LIMIT then table.clear(dCache) end
                dCache[k] = cut
            end
            if cut then stats.block = stats.block + 1 else stats.pass = stats.pass + 1 end
            busy = false
            return cut, k
        end

        --scoreLayer
        local function scoreLayer(s)
            if not s or #s < 100 then return 0 end
            local sample = s:sub(1, 20000)
            local score = math.min(#s // 500, 200)
            for _, tok in ipairs(LUA_TOKENS) do
                local cnt, i = 0, 1
                while true do
                    local j = sample:find(tok, i, true)
                    if not j then break end
                    cnt = cnt + 1; i = j + #tok
                    if cnt >= 10 then break end
                end
                score = score + cnt * 5
            end
            return score
        end

        log("Inicio | placeid=" .. tostring(game.PlaceId)
            .. " | exec=" .. tostring(identifyexecutor and select(1, identifyexecutor()))
            .. " | modo=" .. MODE .. " | auto_black=" .. tostring(AUTO_BLACK))

        --persistencia blacklist
        pcall(function()
            local f = readfile(PERSIST)
            if f then
                local count = 0
                for l in f:gmatch("[^\r\n]+") do
                    if l ~= "" and count < 5000 then BLACK[l] = true; count = count + 1 end
                end
                if count > 0 then
                    log("Blacklist persistente cargada: " .. count .. " dominios desde " .. PERSIST)
                end
            end
        end)

        --VFS hooks
        if VFS then
            pcall(function()
                local vfs = {}
                local isV = function(p)
                    if type(p) ~= "string" then return false end
                    return p:lower():find("static_content", 1, true) ~= nil
                end
                local hooks = {
                    makefolder = function(o) return function(p) if isV(p) then return end; return o(p) end end,
                    writefile  = function(o) return function(p, d) if isV(p) then vfs[p] = tostring(d); return end; return o(p, d) end end,
                    appendfile = function(o) return function(p, d) if isV(p) then vfs[p] = (vfs[p] or "") .. tostring(d); return end; return o(p, d) end end,
                    readfile   = function(o) return function(p) if isV(p) then return vfs[p] or "" end; return o(p) end end,
                    isfile     = function(o) return function(p) if isV(p) then return vfs[p] ~= nil end; return o(p) end end,
                    delfile    = function(o) return function(p) if isV(p) then vfs[p] = nil; return end; return o(p) end end,
                }
                local g = getgenv()
                if g then
                    for name, factory in pairs(hooks) do
                        pcall(hookfn, g, name, factory)
                    end
                end
                if _G and _G ~= g then
                    for name, factory in pairs(hooks) do
                        pcall(hookfn, _G, name, factory)
                    end
                end
            end)
        end

        --loadstring hook
        hookfn(getgenv(), "loadstring", function(orig)
            return function(s, ...)
                if type(s) == "string" and #s > 1000000 then
                    stats.padding = stats.padding + 1
                    log("  -> Capa ignorada por tamaño (gigante/relleno) | bytes=" .. #s)
                    return function() end
                end
                if lsDepth > 0 then
                    local res = table.pack(pcall(orig, s, ...))
                    if not res[1] or not res[2] then return function() end end
                    return table.unpack(res, 2, res.n)
                end
                lsDepth = lsDepth + 1
                layers = layers + 1
                local t = tostring(s)
                local sc = scoreLayer(t)
                if sc >= 20 and #t > 200 then
                    local outPath = pathFor(layers)
                    if pcall(writefile, outPath, t) then
                        log("  -> Capa guardada: " .. uid .. "-c" .. layers .. ".lua | bytes=" .. #t .. " | score=" .. sc)
                    end
                end
                local res = table.pack(pcall(orig, s, ...))
                lsDepth = lsDepth - 1
                if not res[1] then error(res[2], 0) end
                if not res[2] then return function() end end
                return table.unpack(res, 2, res.n)
            end
        end)

        --__namecall hook
        pcall(function()
            local oldNC
            oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                if checkcaller and not checkcaller() then return oldNC(self, ...) end
                local m = getnamecallmethod()
                if m ~= "HttpGet" and m ~= "HttpGetAsync" and m ~= "RequestAsync" then
                    return oldNC(self, ...)
                end
                if os.clock() < bypassUntil then return oldNC(self, ...) end
                local a1, a2 = ...
                local ok, cut
                if m == "RequestAsync" then
                    ok, cut = pcall(net, m, a1.Url, a1.Body)
                else
                    ok, cut = pcall(net, m, a1, a2)
                end
                if ok and cut and FAKE then
                    return { Success = true, StatusCode = 200, Body = "", Headers = {} }
                end
                return oldNC(self, ...)
            end))
        end)

        --api pública
        getgenv().hooklog = {
            block = function(p) BLACK[tostring(p):lower()] = true; table.clear(dCache) end,
            allow = function(p) ALLOW[tostring(p):lower()] = true; table.clear(dCache) end,
            stats = function() return stats end,
        }

        --flush loop
        task.spawn(function() while true do task.wait(1); flush() end end)

        --grace
        bypassUntil = os.clock() + (BYPASS_LOADER and GRACE or 0)
        loading = true

        -- Asegurar que el host del loader NO esté bloqueado
        local loaderHost = host(LOADER_URL)
        if loaderHost then
            BLACK[loaderHost] = nil
            ALLOW[loaderHost] = true
            table.clear(dCache)
        end

        addLine("Descargando loader desde: " .. tostring(LOADER_URL), C.CON_INF, "info", ICO.info)
        local okFetch, src = pcall(function() return game:HttpGet(LOADER_URL) end)
        
        if okFetch and type(src) == "string" then
            log("Loader descargado | bytes=" .. #src .. " | url=" .. tostring(LOADER_URL))
            local fn, lerr = loadstring(src)
            if fn then
                local execOk, execErr = pcall(fn)
                if not execOk then log("Error ejecutando loader: " .. tostring(execErr)) end
            else
                log("Error compilando loader: " .. tostring(lerr))
            end
        else
            log("Error: fallo al descargar el loader principal")
            log("Detalle del error: " .. tostring(src))
        end

        bypassUntil = os.clock() + (BYPASS_LOADER and GRACE or 0)
        loading = false

        --resumen
        task.delay(GRACE + 5, function()
            log("== Resumen de ejecución ==")
            log("  Capas extraídas: " .. layers .. " | carpeta: " .. DIR)
            log("  Pass: " .. stats.pass .. " | Block: " .. stats.block .. " | Unknown: " .. stats.unknown)
            log("  Padding: " .. stats.padding .. " | Dropped: " .. stats.dropped)
            log("  Blacklist activa: " .. (hasRemoteBL and "remota" or "fallback") .. " | persistentes: " .. tostring(#pend))
            flush()
            addLine("=== Completado ===", C.CON_OK, "ok", ICO.check)
            addLine("Capas: " .. layers .. " | Block: " .. stats.block .. " | Unknown: " .. stats.unknown, C.CON_OK, "ok", ICO.check)
        end)
    end)
end

