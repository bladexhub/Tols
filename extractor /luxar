return function(input)
    local g,p,t,s=game,pcall,type,string
    local sf,tc=string.format,table.concat
    local pg=g:GetService("Players")
    local pl=pg.LocalPlayer
    if not pl then for _=1,200 do pl=pg.LocalPlayer if pl then break end task.wait(0.05) end end
    local RN=(pl and pl.Name) or ""
    local RID=(pl and pl.UserId) or 0
    local HW=""
    do local a,b=p(function() if gethwid then return gethwid() end return g:GetService("RbxAnalyticsService"):GetClientId() end) if a and t(b)=="string" then HW=b:gsub("[^%w%-]","") end end
    
    local function getHash(multiplier)
        local raw=RN.."|"..tostring(RID).."|"..HW
        local sm=0 for i=1,#raw do sm=(sm+raw:byte(i))%1000000007 end
        local q=((multiplier*1009)%1000000007+(sm*7919)%1000000007)%1000000007
        local d={}
        local x=(bit32 and bit32.bxor) or (bit and bit.bxor)
        if x then for i=1,#raw do d[i]=sf("%02x", x(raw:byte(i),(multiplier*131+(i-1)*17+59)%256)) end end
        return q, tc(d)
    end

    local req = (syn and syn.request) or (http and http.request) or http_request or request
    
    local function fetchUrl(url, multiplier)
        local q, d = getHash(multiplier)
        local targetUrl = url .. "?q=" .. q .. "&d=" .. d
        print("[Luxar Extractor] Conectando a capa...")
        
        local ok, res
        if req then
            ok, res = pcall(req, {Url = targetUrl, Method = "GET", Headers = { ["User-Agent"] = "Roblox/WinInet" }})
        else
            ok, res = pcall(function() return { Body = g:HttpGet(targetUrl), StatusCode = 200 } end)
        end
        
        if ok and res and res.StatusCode == 200 then return res.Body end
        return nil
    end

    -- Capa 1: El enlace que el usuario ingresó
    local cleanUrl = input:match("https?://[^\"']+") or input
    local baseUrl = cleanUrl:match("^([^?]+)") or cleanUrl
    
    -- Obtenemos el multiplicador del input (por defecto 1560 si no se especifica)
    local mult = tonumber(input:match("(%d+)%*1009")) or 1560
    
    local body = fetchUrl(baseUrl, mult)
    if not body then print("[Luxar Extractor] Error en Capa 1") return end
    
    -- Comprobamos si es otra capa
    local nextUrl = body:match("HttpGet%(\"([^\"]+)\"")
    local nextMult = tonumber(body:match("(%d+)%*1009"))
    
    if nextUrl and nextMult then
        print("[Luxar Extractor] Capa adicional detectada. Extrayendo...")
        -- Limpiamos la URL de la siguiente capa
        local nextBase = nextUrl:match("^([^?]+)") or nextUrl
        body = fetchUrl(nextBase, nextMult)
    end
    
    if not body then print("[Luxar Extractor] Error en capa final") return end
    
    local host = baseUrl:match("^%a+://([^/%?#:]+)") or "luxar"
    local dir = getgenv().EXTRACT_DIR .. "/" .. host
    pcall(makefolder, dir)
    local path = dir .. "/luxar_final_" .. tostring(os.time()) .. ".lua"
    
    if writefile then
        writefile(path, body)
        print("[Luxar Extractor] ¡Script Final Extraído! Guardado en: " .. path)
    end
end
