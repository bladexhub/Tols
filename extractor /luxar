return function(input)
    local g,p,t,s=game,pcall,type,string
    local x=(bit32 and bit32.bxor) or (bit and bit.bxor)
    local sf,tc=string.format,table.concat
    local gv=(getgenv and getgenv()) or {}
    local pg=g:GetService("Players")
    local pl=pg.LocalPlayer
    if not pl then for _=1,200 do pl=pg.LocalPlayer if pl then break end if task and task.wait then task.wait(0.05) else wait(0.05) end end end
    local RN=(pl and pl.Name) or ""
    local RID=(pl and pl.UserId) or 0
    local HW=""
    do local a,b=p(function() if gethwid then return gethwid() end return g:GetService("RbxAnalyticsService"):GetClientId() end) if a and t(b)=="string" then HW=b:gsub("[^%w%-]","") end end
    
    local B=0
    for _,k in ipairs({"__LG_BYPASS","LG_DUMPS","LG_SAVE","LG_DUMP","__LG_GATE","__LG","__dumper","__deobf","__loadstring_hook","__hook_ls"}) do if gv[k]~=nil then B=B+1 end end
    
    local raw=RN.."|"..tostring(RID).."|"..HW
    local sm=0 for i=1,#raw do sm=(sm+raw:byte(i))%1000000007 end
    local q=((1560*1009)%1000000007+(sm*7919)%1000000007+B*48271+(B>0 and 11 or 0))%1000000007
    local d={}
    if x then for i=1,#raw do d[i]=sf("%02x", x(raw:byte(i),(1560*131+(i-1)*17+59)%256)) end end
    d=tc(d)
    
    local baseUrl = input:match("^([^?]+)")
    if not baseUrl then baseUrl = input end
    
    local targetUrl = baseUrl .. "?q=" .. q .. "&d=" .. d
    
    print("[Luxar Extractor] Conectando al servidor...")
    print("[Luxar Extractor] URL: " .. targetUrl)
    
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    local ok, res
    
    if req then
        ok, res = pcall(req, {
            Url = targetUrl,
            Method = "GET",
            Headers = { ["User-Agent"] = "Roblox/WinInet" }
        })
    else
        ok, res = pcall(function() return { Body = g:HttpGet(targetUrl), StatusCode = 200 } end)
    end
    
    if not ok or not res then
        print("[Luxar Extractor] Error de conexión: " .. tostring(res))
        return
    end
    
    print("[Luxar Extractor] Status HTTP: " .. tostring(res.StatusCode))
    
    if res.StatusCode ~= 200 then
        print("[Luxar Extractor] El servidor respondió con error. Cuerpo: " .. tostring(res.Body):sub(1, 200))
        return
    end
    
    local body = res.Body
    if not body or body == "" or body:find("<!DOCTYPE") or body:find("<html") then
        print("[Luxar Extractor] La respuesta no es un script válido (posible bloqueo o mantenimiento).")
        return
    end
    
    local host = targetUrl:match("^%a+://([^/%?#:]+)") or "luxar"
    local dir = getgenv().EXTRACT_DIR .. "/" .. host
    pcall(makefolder, dir)
    
    local fname = "luxar_payload_" .. tostring(os.time()) .. ".lua"
    local path = dir .. "/" .. fname
    
    if writefile then
        writefile(path, body)
        print("[Luxar Extractor] ¡Código extraído con éxito! Guardado en: " .. path)
    else
        print("[Luxar Extractor] Error: writefile no está disponible.")
    end
end
