local hookNC = newcclosure(function(self, ...)
	local method = getnamecallmethod()
	if type(method) == "string" then
		local rule = RV[method]
		if rule and typeof(self) == "Instance" then
			local ok, blocked, ret = pcall(rule, self, method, ...)
			if ok and blocked then return ret end
			setnamecallmethod(method)
		end
	end
	return oldNamecall(self, ...)
end)

local hookIdx = newcclosure(function(self, k)
	if type(k) == "string" and IDX[k] and typeof(self) == "Instance" then
		local f = oldIndex(self, k)
		if type(f) == "function" then
			local rule = RV[k]
			return newcclosure(function(s, ...)
				local ok, blocked, ret = pcall(rule, s, k, ...)
				if ok and blocked then return ret end
				return f(s, ...)
			end)
		end
		return f
	end
	return oldIndex(self, k)
end)

local hookNI = newcclosure(function(self, k, v)
	if type(k) == "string" and NI[k] and (k ~= "Parent" or v == nil) and typeof(self) == "Instance" then
		local ok, blocked = pcall(NI[k], self, v)
		if ok and blocked then return end
	end
	return oldNewIndex(self, k, v)
end)

local function InstallMeta()
	setreadonly(mt, false)
	local ok, err = pcall(function()
		mt.__namecall, mt.__index, mt.__newindex = hookNC, hookIdx, hookNI
	end)
	setreadonly(mt, true)
	if not ok then Log("WARN", "meta", "Fallo al hookear metatabla", err) end
	return ok
end
