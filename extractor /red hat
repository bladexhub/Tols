function API.GetLogs(filter)
	filter = type(filter) == "table" and filter or {}
	local out = {}
	for _, e in ipairs(Logs) do
		if (not filter.Level or e.Level == filter.Level)
			and (not filter.Category or e.Category == filter.Category)
			and (not filter.SinceId or e.Id > filter.SinceId) then
			local c = {}
			for k, v in pairs(e) do c[k] = v end
			out[#out + 1] = c
		end
	end
	if filter.Limit and #out > filter.Limit then
		local t = {}
		for i = #out - filter.Limit + 1, #out do t[#t + 1] = out[i] end
		out = t
	end
	return out
end
