local RV, IDX, NI = {}, {}, {}

local function R(names, fn, wrapOnIndex)
	for _, n in ipairs(names) do
		local camel = slower(ssub(n, 1, 1)) .. ssub(n, 2)
		for _, v in ipairs({ n, camel, slower(n) }) do
			RV[v] = fn
			if wrapOnIndex then IDX[v] = true end
		end
	end
end

