local CRIT = { Head = 1, HumanoidRootPart = 1, Torso = 1, UpperTorso = 1, LowerTorso = 1, Neck = 1, Root = 1 }
local function isCritical(i)
	local c = localChar()
	if not c then return false end
	if i == c then return true end
	if rawIndex(i, "ClassName") == "Humanoid" then return rawIndex(i, "Parent") == c end
	if CRIT[rawIndex(i, "Name")] then
		local p = rawIndex(i, "Parent")
		return p ~= nil and (p == c or rawIndex(p, "Parent") == c)
	end
	return false
end

