local Hooked = {}
local function HookFn(owner, key, handler)
	local orig = owner and owner[key]
	if type(orig) ~= "function" then return false end
	local prev = Hooked[orig]
	if prev then if owner[key] ~= prev then pcall(function() owner[key] = prev end) end return true end
	local old
	local rep = newcclosure(function(...) return handler(old, ...) end)
	if hookfunction then
		local ok, res = pcall(hookfunction, orig, rep)
		if ok and type(res) == "function" then old = res Hooked[orig] = orig return true end
	end
	old = orig
	Hooked[orig] = rep
	return (pcall(function() owner[key] = rep end))
end

local function reqHandler(old, opts, ...)
	if type(opts) == "table" then
		local ok, url, headers, body = pcall(function()
			return opts.Url or opts.url, opts.Headers or opts.headers, opts.Body or opts.body
		end)
		if ok and NetGate("request", url, headers, body) then return FakeResponse() end
	end
	return old(opts, ...)
end
