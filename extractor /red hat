local function Flatten(s)
	s = slower(s)
	s = sgsub(s, "%.%.", "")
	s = sgsub(s, "[%s\"'`,{}%(%)%[%]\\]", "")
	return s
end

local function Scan(text)
	if type(text) ~= "string" or text == "" then return nil end
	if #text > 100000 then text = ssub(text, 1, 100000) end
	for _, v in ipairs(DeepDecode(text)) do
		local flat = Flatten(v)
		local rev = sreverse(flat)
		for _, e in ipairs(BAD) do
			if sfind(flat, e[2], 1, true) or sfind(rev, e[2], 1, true) then return e[1], e[2] end
		end
		if sfind(flat, "https?://%d+%.%d+%.%d+%.%d+") then return "ip-directa", "http://<ip>" end
	end
end

local OBF_SIGS = { "luraph", "lph_", "lph!", "moonsec", "wearedevs.net/obfuscator", "ironbrew", "iron brew",
	"prometheus obfuscator", "levno_710", "boronide", "luaobfuscator", "aztupbrew", "synapse xen",
