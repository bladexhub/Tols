local function Log(level, category, message, detail)
	LogId += 1
	local e = {
		Id = LogId, Time = os.time(), Level = level, Category = category,
		Message = message, Detail = detail and ssub(tostring(detail), 1, 300) or nil,
		Color = COLORS[level] or COLORS.INFO,
	}
	Logs[#Logs + 1] = e
	if #Logs > Config.MaxLogs then table.remove(Logs, 1) end
	Stats[level] = (Stats[level] or 0) + 1
	Stats.ByCategory[category] = (Stats.ByCategory[category] or 0) + 1
	for _, cb in ipairs(Listeners) do task.spawn(pcall, cb, e) end
	
	if Config.Notify and level ~= "INFO" then
		local now = os.clock()
		if not lastNotify[category] or now - lastNotify[category] > 3 then
			lastNotify[category] = now
			task.defer(pcall, function()
				StarterGui:SetCore("SendNotification", {
					Title = "RED HAT [" .. level .. "]", Text = ssub(message, 1, 90), Duration = 4,
				})
			end)
		end
	end

	if writefile and (level == "BLOCK" or level == "WARN") then
		task.spawn(function()
			local text = string.format("[%s] [%s] [%s] %s | %s\n", 
				os.date("%Y-%m-%d %H:%M:%S"), level, category, message, tostring(detail))
			pcall(function()
				if appendfile then
					appendfile(LOG_FILE, text)
				else
					local old = isfile(LOG_FILE) and readfile(LOG_FILE) or ""
					writefile(LOG_FILE, old .. text)
				end
			end)
		end)
	end
end

local b64map = {}
do
	local A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, 64 do b64map[sbyte(A, i)] = i - 1 end
	b64map[sbyte("-")], b64map[sbyte("_")] = 62, 63
end

local function b64decode(s)
	s = sgsub(s, "[^%w%+/%-_]", "")
	local out, bits, nb = {}, 0, 0
	for i = 1, #s do
		local v = b64map[sbyte(s, i)]
		if not v then return nil end
		bits = bits * 64 + v
		nb += 6
		if nb >= 8 then
			nb -= 8
			local byte = math.floor(bits / 2 ^ nb)
			bits = bits % 2 ^ nb
			out[#out + 1] = schar(byte)
		end
	end
	return table.concat(out)
end

local function hexdecode(s)
	if #s % 2 ~= 0 or sfind(s, "[^%x]") then return nil end
	return (sgsub(s, "%x%x", function(h) return schar(tonumber(h, 16)) end))
end

local function urldecode(s)
	return (sgsub(s, "%%(%x%x)", function(h) return schar(tonumber(h, 16)) end))
end

local function unescape(s)
	s = sgsub(s, "\\x(%x%x)", function(h) return schar(tonumber(h, 16)) end)
	s = sgsub(s, "\\(%d%d?%d?)", function(d)
		local n = tonumber(d)
		if n and n < 256 then return schar(n) end
	end)
	s = sgsub(s, "\\u{(%x+)}", function(h)
		local n = tonumber(h, 16)
		if n and n < 128 then return schar(n) end
	end)
	return s
end

local function charcalls(s)
	return (sgsub(s, "string%.char%s*%(([%dx%x%s,]-)%)", function(args)
		local out = {}
		for tok in sgmatch(args, "[^,]+") do
			local n = tonumber((sgsub(tok, "%s", "")))
			if not n or n < 0 or n > 255 then return nil end
			out[#out + 1] = schar(n)
		end
		return table.concat(out)
	end))
end

local function printableRatio(s)
	local n = #s
	if n == 0 then return 1 end
	local p = 0
	for i = 1, n do
		local b = sbyte(s, i)
		if (b >= 32 and b < 127) or b == 9 or b == 10 or b == 13 then p += 1 end
	end
	return p / n
end

local TARGET_WORDS = { "http", "://", "roblox", "discord", "webhook", ".com" }
local function looksLikeTarget(s)
	local l = slower(s)
	for _, k in ipairs(TARGET_WORDS) do if sfind(l, k, 1, true) then return true end end
	return false
end

local function DeepDecode(text)
	local out, seen, queue, qi = { text }, { [text] = true }, { { text, 0 } }, 1
	local function push(v, d)
		if v and v ~= "" and not seen[v] and #out < 48 then
			seen[v] = true
			out[#out + 1] = v
			queue[#queue + 1] = { v, d }
		end
	end
	while qi <= #queue do
		local cur, d = queue[qi][1], queue[qi][2]
		qi += 1
		if d < 5 then
			push(urldecode(cur), d + 1)
			push(unescape(cur), d + 1)
			push(charcalls(cur), d + 1)
			for tok in sgmatch(cur, "[%w%+/%-_=]+") do
				if #tok >= 16 then
					local dec = hexdecode(tok)
					if not dec or printableRatio(dec) < 0.85 then dec = b64decode(tok) end
					if dec and printableRatio(dec) >= 0.85 then push(dec, d + 1) end
				end
			end
			if bxor and #cur >= 8 and #cur <= 4096 and printableRatio(cur) < 0.7 then
				for key = 1, 255 do
					local buf = {}
					for i = 1, #cur do buf[i] = schar(bxor(sbyte(cur, i), key)) end
					local r = table.concat(buf)
					if printableRatio(r) >= 0.95 and looksLikeTarget(r) then push(r, d + 1) break end
				end
			end
		end
	end
	return out
end

