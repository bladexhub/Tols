local function netRule(self, name, a1, a2, a3, a4, a5)
	local l, url, headers, body = slower(name), nil, nil, nil
	if l == "requestasync" or l == "requestinternal" then
		if type(a1) == "table" then url, headers, body = a1.Url, a1.Headers, a1.Body end
	elseif l == "httppost" or l == "httppostasync" then url, body = a1, a2
	elseif l == "postasync" then url, body, headers = a1, a2, a5
	elseif l == "getasync" then url, headers = a1, a3
	else url = a1 end
	if NetGate(name, url, headers, body) then
		if l == "requestasync" then return true, FakeResponse() end
		if l == "requestinternal" then return true, FakeInternal() end
		return true, ""
	end
end
