local function Entropy(s)
	if #s > 200000 then s = ssub(s, 1, 200000) end
	local len = #s
	if len == 0 then return 0 end
	local freq = {}
	for i = 1, len do
		local b = sbyte(s, i)
		freq[b] = (freq[b] or 0) + 1
	end
	local e = 0
	for _, c in pairs(freq) do
		local p = c / len
		e -= p * math.log(p, 2)
	end
	return e
end

local function Analyze(src)
	local res = { block = false, warn = false, reasons = {}, entropy = 0 }
	if type(src) ~= "string" then return res end
	local sample = #src > 200000 and ssub(src, 1, 200000) or src
	local obf = false
	local low = slower(sample)
	for _, sig in ipairs(OBF_SIGS) do
		if sfind(low, sig, 1, true) then
			obf = true
			res.reasons[#res.reasons + 1] = "firma: " .. sig
			break
		end
	end
	if #sample >= Config.EntropyMinLen then
		res.entropy = Entropy(sample)
		if res.entropy >= Config.EntropyThreshold then
			obf = true
			res.reasons[#res.reasons + 1] = ("entropía %.2f"):format(res.entropy)
		elseif res.entropy >= Config.EntropyThreshold - 0.35 then
			res.warn = true
			res.reasons[#res.reasons + 1] = ("entropía sospechosa %.2f"):format(res.entropy)
		end
	end
	local seg = ssub(sample, 1, 50000)
	local _, esc = sgsub(seg, "\\%d%d%d", "")
	if esc > 200 and (esc * 4) / math.max(#seg, 1) > 0.3 then
		obf = true
		res.reasons[#res.reasons + 1] = "exceso de escapes \\ddd"
	end
	if obf then
		if Config.ObfMode == "block" then res.block = true else res.warn = true end
	end
	local cat, pat = Scan(sample)
	if cat then
		res.block = true
		res.reasons[#res.reasons + 1] = "exfiltración [" .. cat .. "]: " .. pat
	end
	return res
end

local function ser(v, d)
	d = d or 0
	if type(v) == "table" and d < 3 then
		local parts = {}
		for k, x in pairs(v) do parts[#parts + 1] = tostring(k) .. ":" .. ser(x, d + 1) end
		return table.concat(parts, "\n")
	end
	return tostring(v)
end

local function hostAllowed(url)
	local auth = smatch(slower(tostring(url)), "^%a[%w%+%.%-]*://([^/%?#]+)")
	if not auth then return false end
	auth = sgsub(sgsub(auth, "^.*@", ""), ":%d+$", "")
	for _, h in ipairs(Config.AllowHosts) do
		h = slower(h)
		if auth == h or ssub(auth, -#h - 1) == "." .. h then return true end
	end
	return false
end

local function NetGate(kind, url, headers, body)
    if rawget(genv, "isInternalFetch") == true then return false end
    
	local short = ssub(tostring(url), 1, 120)
	if Config.NetMode == "blockall" then
		Log("BLOCK", "net", kind .. " bloqueado (NetMode=blockall)", short)
		return true
	end
	local ok, blob = pcall(function() return tostring(url) .. "\n" .. ser(headers) .. "\n" .. ser(body) end)
	if ok then
		local cat, pat = Scan(blob)
		if cat then
			Log("BLOCK", "net", kind .. " bloqueado [" .. cat .. "]", short)
			return true
		end
	end
	if Config.StrictAllowlist and not hostAllowed(url) then
		Log("BLOCK", "net", kind .. " bloqueado (host fuera de allowlist)", short)
		return true
	end
	return false
end

