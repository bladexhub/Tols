-- url
local function extractURL(input)
    if type(input) ~= "string" then return nil end
    input = input:match("^%s*(.-)%s*$")
    if input == "" then return nil end
    local u = input:match("^(https?://%S+)$"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et%s*%(?%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et%s*%(?%s*%[=*%[([^%]]+)%]=*%]"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et[Aa]sync%s*%(?%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("[Uu]rl%s*=%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("[Uu][Rr][Ll]%s*=%s*%[=*%[([^%]]+)%]=*%]"); if u then return u end
    u = input:match("(https?://[^%s\"'%)%]]+)"); if u then return u end
    return nil
end

-- paths
local function makePaths(url)
    local host = string.match(url, "^https?://([^/%?#]+)") or "unknown.host"
    host = host:gsub(":%d+$", ""):gsub("[^%w%.%-_]", "_")
    local uid = string.match(url:gsub("[?#].*$", ""):gsub("/+$", ""), "/([^/]+)$") or string.format("%x", os.time())
    uid = uid:gsub("[^%w%-_]", "_")
    local BASE, EXTRACT = "Bladex", "Bladex/extract"
    local finalDir = EXTRACT .. "/" .. host
    local useSub = false
    if makefolder and isfolder then
        if not isfolder(BASE) then pcall(makefolder, BASE) end
        if isfolder(BASE) and not isfolder(EXTRACT) then pcall(makefolder, EXTRACT) end
        if isfolder(EXTRACT) and not isfolder(finalDir) then pcall(makefolder, finalDir) end
        if isfolder(finalDir) then useSub = true end
    end
    local function pathFor(n)
        if useSub then return finalDir .. "/" .. uid .. "-c" .. n .. ".lua"
        else return "Bladex/extract/" .. host .. "_" .. uid .. "-c" .. n .. ".lua" end
    end
    return host, uid, pathFor, finalDir
end

-- ser
local function serLua(t)
    if type(t) == "string" then
        return '"' .. t:gsub(".", function(c) return "\\"..c:byte() end) .. '"'
    elseif type(t) == "number" then
        return tostring(t)
    elseif type(t) == "table" then
        local p = {"{"}
        for i = 1, #t do p[#p+1] = serLua(t[i]); p[#p+1] = "," end
        p[#p+1] = "}"
        return table.concat(p)
    end
    return "nil"
end

-- chk
local function isLayer(code)
    if type(code) ~= "string" or #code < 150 then return false end
    if string.find(code, "^%-%- LuaGate") then return true end
    local p1 = string.find(code, "loadstring", 1, true)
    if p1 then
        local p2 = string.find(code, "HttpGet", p1, true)
        if p2 then return true end
    end
    if string.find(code, "HttpGetAsync", 1, true) then return true end
    if #code > 500 and string.find(code, "function", 1, true) then return true end
    return false
end

-- chk
local function isLuarmor(code)
    if type(code) ~= "string" then return false end
    if string.find(code, "superflow_bytecode", 1, true) then return true end
    if string.find(code, "Luarmor V4 bootstrapper", 1, true) then return true end
    if string.find(code, "_bsdata", 1, true) and string.find(code, "=", 1, true) then return true end
    return false
end

exec = function(input)
    if not input or input:match("^%s*$") then return end
    table.insert(history, 1, input)
    if #history > 60 then table.remove(history) end
    histIdx = 0

    local url = extractURL(input)
    if not url then
        addLine("Error: Sin URL.", C.CON_ERR, "err", ICO.error)
        return
    end

    addLine("URL detectada.", C.CON_SYS, "info", ICO.chevron)

    local bsFromInput = input:match("_bsdata%d+%s*=%s*(%b{})")
    
    -- Extraer variables globales
    local sharedGenv = {}
    for name, tbl in input:gmatch("getgenv%(%)%.([%w_]+)%s*=%s*(%b{})") do
        local chunk = loadstring("return " .. tbl)
        if chunk then
            local ok, res = pcall(chunk)
            if ok then sharedGenv[name] = res end
        end
    end

    task.spawn(function()
        local host, uid, pathFor, runDir = makePaths(url)
        addLine("Host: " .. host, C.CON_SYS, "info", ICO.check)

        local layersCapturadas = 0
        local archivosEscritos = {}
        local luarmorLayers = {}
        local hitLuarmor = false

        addLine("Descargando...", C.CON_INF, "info", ICO.info)
        task.wait(0.3) 
        
        local ok, layer1 = pcall(function() return game:HttpGet(url) end)
        if not ok or not layer1 then
            addLine("Error: Red bloqueada.", C.CON_ERR, "err", ICO.error); return
        end
        local head = string.lower(string.sub(layer1, 1, 20))
        if string.find(head, "<!doctype", 1, true) or string.find(head, "<html", 1, true) then
            addLine("Error: HTML devuelto.", C.CON_ERR, "err", ICO.error); return
        end
        
        addLine("Raíz: " .. #layer1 .. "b", C.CON_SYS, "info", ICO.check)
        task.wait(0.1)

        -- env
        local env = setmetatable({}, {__index = getfenv()})
        env.task = task
        env.pcall = pcall; env.type = type; env.string = string; env.table = table
        env.tostring = tostring; env.tonumber = tonumber; env.os = os; env.debug = debug
        env.select = select; env.unpack = table.unpack or unpack
        env.warn = function(...)
            local p = {}; for i = 1, select('#', ...) do p[#p+1] = tostring(select(i, ...)) end
            addLine("warn: " .. table.concat(p, " "), C.CON_WRN, "warn", ICO.warn)
        end
        env.print = env.warn
        env.error = function(m) addLine("error: " .. tostring(m), C.CON_ERR, "err", ICO.error) end
        
        -- Inyectar getgenv personalizado
        env.getgenv = function() return sharedGenv end
        
        env.listfiles = function() return {} end; env.delfile = function() end
        env.islclosure = function() return false end; env.isfunctionhooked = function() return false end
        env.getrawmetatable = function() return {} end
        env.setreadonly = function() end; env.checkcaller = function() return true end

        -- b32
        local fb32 = bit32 or (bit and {bxor=bit.bxor, band=bit.band, bor=bit.bor,
            bnot=bit.bnot, lshift=bit.lshift, rshift=bit.rshift,
            arshift=bit.arshift, btest=bit.btest,
            tobit=function(x) return x end, tohex=function(x) return string.format("%08x",x) end
        }) or (function()
            local function bxor(a,b)
                local r,p=0,1
                while a>0 or b>0 do
                    if (a%2)~=(b%2) then r=r+p end
                    a=math.floor(a/2); b=math.floor(b/2); p=p*2
                end
                return r
            end
            return {bxor=bxor}
        end)()
        env.bit32 = fb32; env.bit = bit or fb32
        env.math = math; env.utf8 = utf8; env.coroutine = coroutine

        -- game
        local realGame = game
        env.game = setmetatable({}, {__index = function(_, k)
            if k == "HttpGet" or k == "HttpGetAsync" then
                return function(a,b)
                    local u = (type(b)=="string" and b) or (type(a)=="string" and a)
                    if not u then return nil end
                    local ok2, res = pcall(function() return realGame:HttpGet(u) end)
                    if not ok2 or type(res)~="string" then return nil end
                    local h = string.lower(string.sub(res,1,20))
                    if string.find(h,"<!doctype",1,true) or string.find(h,"<html",1,true) then return nil end
                    return res
                end
            elseif k == "GetService" then
                return function(_, name)
                    if name == "Players" then
                        return {LocalPlayer={Name="Player",UserId=0,Kick=function() end,Character=nil,WaitForChild=function() return nil end}, GetPlayers=function() return {} end}
                    end
                    return realGame:GetService(name)
                end
            end
            return realGame[k]
        end})

        -- save
        local function writeLayer(code, tag)
            layersCapturadas = layersCapturadas + 1
            local out = pathFor(layersCapturadas)
            archivosEscritos[#archivosEscritos + 1] = out
            
            addLine("Guardando #" .. layersCapturadas, C.CON_SYS, "info", ICO.check)
            task.wait(0.1)
            
            if writefile then
                local wok = pcall(writefile, out, code)
                if wok then
                    addLine("[" .. layersCapturadas .. "] " .. (tag or "?") .. " (" .. #code .. "b)", C.CON_OK, "ok", ICO.check)
                end
            end
            task.wait(0.1)
            return out
        end

        -- ls
        env.loadstring = function(code)
            if type(code) ~= "string" then return nil, "bad arg" end
            if #code == 0 then return nil, "empty code" end
            
            addLine("Compilando " .. #code .. "b", C.CON_SYS, "info", ICO.info)
            task.wait(0.1) 
            
            local fn, err = loadstring(code)
            if not fn then
                addLine("Error sintaxis.", C.CON_ERR, "err", ICO.error)
                return nil, err
            end
            pcall(setfenv, fn, env)

            if isLayer(code) then
                local tag = "?"
                local m = string.match(code, "^%-%-%s*([^\n]+)")
                if m then tag = m end

                if isLuarmor(code) then
                    hitLuarmor = true
                    local out = writeLayer(code, "Lua#" .. (#luarmorLayers + 1))
                    luarmorLayers[#luarmorLayers + 1] = {code = code, file = out}
                    addLine("→ Lua encolado", C.CON_OK, "ok", ICO.check)
                    return function() end
                end
                writeLayer(code, tag)
            end
            return fn
        end
        env.load = env.loadstring
        env.loadfile = function(p) local c = readfile and readfile(p); if c then return env.loadstring(c) end; return nil end

        -- root
        addLine("Ejecutando raíz...", C.CON_INF, "info", ICO.info)
        task.wait(0.3) 
        
        local fn1, errInit = env.loadstring(layer1)
        if not fn1 then addLine("Error raíz.", C.CON_ERR, "err", ICO.error); return end
        pcall(setfenv, fn1, env)
        local ok1, errExec = pcall(fn1)
        if not ok1 then addLine("Aviso raíz: "..tostring(errExec), C.CON_WRN, "warn", ICO.warn) end

        -- wait
        local t = 0
        local lastCount = layersCapturadas
        while t < 60 do
            if layersCapturadas ~= lastCount then lastCount = layersCapturadas; t = 0 end
            if hitLuarmor and t >= 3 then break end
            task.wait(1); t = t + 1
        end

        if layersCapturadas == 0 then
            addLine("Error 410: Enlace caído o fallo de Loader.", C.CON_ERR, "err", ICO.error); return
        end

        -- fase2
        if #luarmorLayers > 0 then
            addLine(" ", C.CON_SYS)
            addLine("── Fase 2: " .. #luarmorLayers .. " Lua", C.CON_INF, "info", ICO.info)

            -- bsdata
            local bsdata0, bsdata0Src = nil, nil
            if bsFromInput then bsdata0 = bsFromInput; bsdata0Src = "input" end

            if not bsdata0 and readfile then
                for _, f in ipairs(archivosEscritos) do
                    local ok2, content = pcall(readfile, f)
                    if ok2 and type(content) == "string" then
                        local m = content:match("_bsdata%d+%s*=%s*(%b{})")
                        if m then bsdata0 = m; bsdata0Src = "archivo"; break end
                    end
                end
            end

            if not bsdata0 and env._bsdata0 then
                bsdata0 = serLua(env._bsdata0); bsdata0Src = "env"
            end

            if not bsdata0 then
                addLine("Falta _bsdata0.", C.CON_WRN, "warn", ICO.warn)
            else
                addLine("_bsdata0: " .. bsdata0Src, C.CON_OK, "ok", ICO.check)

                -- loop
                local idx = 1
                while idx <= #luarmorLayers do
                    local layer = luarmorLayers[idx]
                    addLine("── Lua #" .. idx .. " ──", C.CON_INF, "info", ICO.chevron)

                    local env2 = setmetatable({}, {__index = env})
                    env2.getgenv = function() return sharedGenv end
                    
                    env2.loadstring = function(c2)
                        if type(c2) ~= "string" then return nil end
                        addLine("Comp: " .. #c2 .. "b", C.CON_SYS, "info", ICO.info)
                        task.wait(0.2)

                        local fn2, err2 = loadstring(c2)
                        if not fn2 then return nil, err2 end
                        pcall(setfenv, fn2, env2)

                        if isLuarmor(c2) then
                            local out = writeLayer(c2, "Lua#" .. (#luarmorLayers + 1))
                            luarmorLayers[#luarmorLayers + 1] = {code = c2, file = out}
                            addLine("  ↳ Anidado", C.CON_OK, "ok", ICO.check)
                            return function() end
                        end

                        local s1 = string.find(c2, "loadstring", 1, true)
                        local s2 = string.find(c2, "HttpGet", 1, true)
                        if #c2 > 400 and (s1 or s2) then
                            writeLayer(c2, "dec")
                        end
                        return fn2
                    end
                    env2.load  = env2.loadstring
                    env2.loadfile = env.loadfile

                    local fullCode = "_bsdata0=" .. bsdata0 .. "\n\n" .. layer.code
                    
                    addLine("  Prep bytecode...", C.CON_SYS, "info", ICO.info)
                    task.wait(0.2) 
                    
                    local fullFn, fullErr = loadstring(fullCode)
                    if not fullFn then
                        addLine("  Error sintaxis.", C.CON_ERR, "err", ICO.error)
                    else
                        pcall(setfenv, fullFn, env2)
                        
                        addLine("  Ejecutando...", C.CON_WRN, "warn", ICO.warn)
                        task.wait(0.5) 
                        
                        local ok3, result = pcall(fullFn)

                        if env2._bsdata0 and (not bsdata0 or bsdata0Src ~= "env") then
                            bsdata0 = serLua(env2._bsdata0)
                            bsdata0Src = "env2"
                            addLine("  ↳ _bsdata0 runtime", C.CON_SYS, "info", ICO.check)
                        end

                        if ok3 then
                            addLine("  OK: " .. type(result), C.CON_OK, "ok", ICO.check)

                            if type(result) == "function" then
                                task.wait(0.3) 
                                local ok4, res2 = pcall(result)
                                if ok4 then
                                    addLine("  Run OK.", C.CON_OK, "ok", ICO.check)
                                    if type(res2) == "string" and isLuarmor(res2) then
                                        local out = writeLayer(res2, "Lua ret#" .. (#luarmorLayers + 1))
                                        luarmorLayers[#luarmorLayers + 1] = {code = res2, file = out}
                                        addLine("  ↳ Ret anidado", C.CON_OK, "ok", ICO.check)
                                    end
                                else
                                    addLine("  Aviso: " .. tostring(res2), C.CON_WRN, "warn", ICO.warn)
                                end
                            end
                        else
                            addLine("  Error: " .. tostring(result), C.CON_WRN, "warn", ICO.warn)
                        end
                    end

                    idx = idx + 1
                    addLine("  Limpiando RAM...", C.CON_SYS, "info", ICO.check)
                    collectgarbage("collect") 
                    task.wait(0.5) 
                end

                addLine("Lua terminado.", C.CON_OK, "ok", ICO.check)
            end
        end

        addLine(" ", C.CON_SYS)
        addLine("=== Completado ===", C.CON_OK, "ok", ICO.check)
        addLine("Total: " .. layersCapturadas, C.CON_OK, "ok", ICO.check)
        for _, f in ipairs(archivosEscritos) do addLine(" " .. f, C.CON_SYS, "info", ICO.chevron) end
    end)
end

