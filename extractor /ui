local lineCounter = 0
local isOpen = true
local savedScroll = nil
local lockScroll = false
local scrollConn = nil

local function killScroll() if scrollConn then scrollConn:Disconnect(); scrollConn = nil end end
local function maxScrollY() return math.max(0, CON_SCR.AbsoluteCanvasSize.Y - CON_SCR.AbsoluteWindowSize.Y) end

local function doScrollTo(targetY)
    if not CON_SCR.Parent then return end
    killScroll()
    local startX = CON_SCR.CanvasPosition.X
    local startY = CON_SCR.CanvasPosition.Y
    if math.abs(targetY - startY) <= 1 then CON_SCR.CanvasPosition = Vector2.new(startX, targetY); return end
    local t0 = os.clock()
    scrollConn = RunService.RenderStepped:Connect(function()
        if not CON_SCR.Parent or lockScroll then killScroll(); return end
        local a = math.min((os.clock() - t0) / 0.18, 1)
        local e = 1 - (1 - a) * (1 - a)
        local ty = math.min(targetY, maxScrollY())
        CON_SCR.CanvasPosition = Vector2.new(startX, startY + (ty - startY) * e)
        if a >= 1 then CON_SCR.CanvasPosition = Vector2.new(startX, maxScrollY()); killScroll() end
    end)
end

local function scrollToBottom()
    if not isOpen or lockScroll then return end
    task.defer(function()
        if not isOpen or lockScroll or not CON_SCR.Parent then return end
        RunService.Heartbeat:Wait(); doScrollTo(maxScrollY())
    end)
end

