-- extractor
exec = function(input)
    if not input or input:match("^%s*$") then return end
    table.insert(history, 1, input)
    if #history > 60 then table.remove(history) end
    histIdx = 0

    local url = string.match(input, "(https?://[^\"']+)")
    if not url then
        addLine("Error: Enlace no válido.", C.CON_ERR, "err", ICO.error)
        return
    end

    addLine("Iniciando extracción...", C.CON_INF, "info", ICO.info)

    task.spawn(function()
        if makefolder and not isfolder("bladex_extract") then
            pcall(function() makefolder("bladex_extract") end)
        end

        local hash = string.match(url, "/([a-fA-F0-9]+)$")
        local archivo_salida = "bladex_extract/payload_" .. (hash or tostring(os.time())) .. ".lua"
        local capturado = false

        local ok, layer1 = pcall(function() return game:HttpGet(url) end)
        if not ok or not layer1 then
            addLine("Error: Red bloqueada o URL expirada.", C.CON_ERR, "err", ICO.error)
            return
        end

        -- sandbox
        local env = setmetatable({}, {__index = getfenv()})
        env.task = task
        env.game = {
            HttpGet = function(self, u)
                local req_ok, res = pcall(function() return game:HttpGet(u) end)
                if req_ok and type(res) == "string" and not string.find(res, "<html") then return res end
            end,
            GetService = function(self, name)
                if name == "Players" then return { LocalPlayer = { Kick = function() end } } end
                return game:GetService(name)
            end
        }
        env.pcall = pcall; env.type = type; env.string = string; env.table = table
        env.tostring = tostring; env.tonumber = tonumber; env.os = os; env.debug = debug
        env.getgenv = function() return { LG_DEBUG = false } end
        env.listfiles = function() return {} end; env.delfile = function() end
        env.islclosure = function() return false end; env.isfunctionhooked = function() return false end

        -- hook
        env.loadstring = function(code)
            if type(code) ~= "string" then return function() end end
            if string.sub(code, 1, 4) == "--LG" then return function() end end

            if string.find(code, "LuaGate v3 %[2/4%]") then
                addLine("Capa 2 atrapada. Descargando...", C.CON_OK, "info", ICO.check)
                local fn = loadstring(code)
                if fn then setfenv(fn, env); task.spawn(function() pcall(fn) end) end
                return function() end
            end

            if #code > 500 and (string.find(code, "function") or string.find(code, "local")) then
                capturado = true
                if writefile then
                    local success = pcall(function() writefile(archivo_salida, code) end)
                    if success then
                        addLine("¡Éxito! Guardado en: " .. archivo_salida, C.CON_OK, "ok", ICO.check)
                    else
                        addLine("Error al escribir archivo.", C.CON_ERR, "err", ICO.error)
                    end
                else
                    addLine("¡Capa 3 capturada! (Sin writefile)", C.CON_OK, "ok", ICO.check)
                end
                return function() end
            end
            return loadstring(code)
        end

        -- capa 1
        local fn1 = loadstring(layer1)
        if fn1 then setfenv(fn1, env); pcall(fn1) end

        -- espera
        local t = 0
        while not capturado and t < 15 do task.wait(1); t = t + 1 end

        if not capturado then
            addLine("Error 410: IP bloqueada o enlace expirado.", C.CON_ERR, "err", ICO.error)
            addLine("Prueba usando VPN o Datos Móviles.", C.CON_WRN, "warn", ICO.warn)
        end
    end)
end

