local CLOSED = false

local function showWindow()
    REOPEN_BTN.Visible = false; CON_SCR.Visible = false; WIN.Visible = true; WIN_SCALE.Scale = 0.9; isOpen = true
    local target = savedScroll
    if target then lockScroll = true end
    if target and CON_SCR.Parent then CON_SCR.CanvasPosition = target end
    TW(WIN_SCALE, TI_POP, {Scale=1})
    task.spawn(function()
        for _ = 1, 3 do RunService.Heartbeat:Wait() end
        if not isOpen then lockScroll = false; return end
        if target and CON_SCR.Parent then CON_SCR.CanvasPosition = target end
        if CON_SCR.Parent then CON_SCR.Visible = true end
        lockScroll = false; savedScroll = nil
    end)
end

local function hideWindow()
    killScroll(); CON_SCR.Visible = false
    if CON_SCR.Parent then savedScroll = CON_SCR.CanvasPosition end
    isOpen = false
    local t = TWc(WIN_SCALE, TI_FAST, {Scale=0.9})
    t.Completed:Connect(function()
        if WIN and WIN.Parent and not CLOSED then WIN.Visible = false; WIN_SCALE.Scale = 1; REOPEN_BTN.Visible = true end
    end)
end

local function shutdown()
    if CLOSED then return end
    CLOSED = true
    dragging = false; resizing = false; activeHandle = nil
    dragStart, winStart = nil, nil; resizeStart, resizeWinPos, resizeWinSize = nil, nil, nil; savedScroll = nil
    pcall(killScroll)
    for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
    connections = {}
    pcall(function() if loaderThread then task.cancel(loaderThread) end end)
    pcall(function() if GUI and GUI.Parent then GUI:Destroy() end end)
end

