local lineBuffer = {}
local lineHead = 1
local lineTotal = 0

local function trackRow(row)
    lineBuffer[lineHead] = row
    lineHead = lineHead + 1
    lineTotal = lineTotal + 1
    if lineTotal > MAX_LINES then
        local old = lineBuffer[lineHead - 1]
        if old then
            old:Destroy()
            lineBuffer[lineHead - 1] = nil
        end
        lineTotal = lineTotal - 1
        if lineHead > MAX_LINES then lineHead = 1 end
    end
end

local function scrollToBottom()
    task.defer(function()
        if CON_SCR.Parent then
            local target = Vector2.new(0, CON_SCR.AbsoluteCanvasSize.Y)
            local start = CON_SCR.CanvasPosition
            if (target - start).Magnitude > 1 then
                local t0 = os.clock()
                local conn
                conn = RunService.RenderStepped:Connect(function()
                    local a = math.min((os.clock() - t0) / 0.18, 1)
                    local e = 1 - (1 - a) * (1 - a)
                    CON_SCR.CanvasPosition = start:Lerp(target, e)
                    if a >= 1 then
                        if conn then conn:Disconnect() end
                    end
                end)
            end
        end
    end)
end

local function addSpacer(height)
    height = height or 6
