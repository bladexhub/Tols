        Size = UDim2.new(1, 0, 0, height),
        BackgroundTransparency = 1,
        LayoutOrder = lineTotal + 1,
        ZIndex = 16,
    }, CON_SCR)
    trackRow(row)
    scrollToBottom()
    return row
end

