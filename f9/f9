local history = {}
local histIdx = 0

function exec(code)
    if not code or code:match("^%s*$") then return end
    table.insert(history, 1, code)
    if #history > 60 then table.remove(history) end
    histIdx = 0

    local refs = peekCode(code)

    local fn, synErr = loadstring(code)
    if not fn then
        local info = parseError(synErr)
        local head = "Syntax error"
        if info.line then head = head .. " (línea " .. info.line .. ")" end
        addLine(head .. ": " .. info.msg, C.CON_ERR, "err", ICO.error)
        if info.line and refs[info.line] then
            highlightLine(refs[info.line], C.CON_ERR)
        end
        return
    end

    local ok, result = xpcall(fn, function(e)
        return debug.traceback(tostring(e), 2)
    end)

    if not ok then
        local info = parseError(result)
        local head = "Error"
        if info.line then head = head .. " (línea " .. info.line .. ")" end
        addLine(head .. ": " .. info.msg, C.CON_ERR, "err", ICO.error)
        if info.line and refs[info.line] then
            highlightLine(refs[info.line], C.CON_ERR)
        end
        local stackLine = tostring(result):match("Script '.-', Line %d+")
        if stackLine then
            addLine("  ↳ " .. stackLine, C.CON_ERR, "err", nil)
        end
    elseif result ~= nil then
        addLine(tostring(result), C.CON_RET, "ok", ICO.ret)
    else
        addLine("Done", C.CON_OK, "ok", ICO.check)
    end
end

