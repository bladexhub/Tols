local function shouldIgnore(msg)
    for _, pat in ipairs(IGNORE_PATTERNS) do
        if msg:match(pat) then return true end
    end
    return false
end

local function fetch(url)
    local ok, res = pcall(game.HttpGet, game, url)
    if ok and type(res) == "string" and #res > 0 then
        return res
    end
    warn("[Bladex] No se pudo descargar: " .. url)
    return nil
end

local function fetchTable(url)
    local code = fetch(url)
    if not code then return nil end
    local fn, err = loadstring(code)
    if not fn then
        warn("[Bladex] Syntax error: " .. tostring(err))
        return nil
    end
    local ok, res = pcall(fn)
    if not ok or type(res) ~= "table" then
        warn("[Bladex] No devolvió tabla: " .. url)
        return nil
    end
    return res
end

local function fetchFunc(url)
    local code = fetch(url)
    if not code then return nil end
    local fn, err = loadstring(code)
    if not fn then
        warn("[Bladex] Syntax error: " .. tostring(err))
        return nil
    end
    return fn
end

