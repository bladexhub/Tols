local function parseError(err)
    if type(err) ~= "string" then return { msg = tostring(err) } end
    local clean = err
    local line
    local l = clean:match(":(%d+):")
    if l then line = tonumber(l) end
    clean = clean:gsub("^.-:%d+:%s*", "")
    clean = clean:gsub("\nStack Begin.*", "")
    clean = clean:gsub("\nstack traceback:.*", "")
    return {
        line = line,
        msg = clean,
        raw = err,
    }
end

local function getAnimProfile(total)
    if total > ANIM_MAX_LINES then
        return { batch = total, delay = 0 }
    elseif total > 3000 then
        return { batch = math.max(1, math.ceil(total / 30)), delay = 0.05 }
    elseif total > 1000 then
        return { batch = math.max(1, math.ceil(total / 40)), delay = 0.05 }
    elseif total > 500 then
        return { batch = math.max(1, math.ceil(total / 50)), delay = 0.04 }
    elseif total > 200 then
        return { batch = 2, delay = 0.02 }
    elseif total > 80 then
        return { batch = 1, delay = 0.018 }
    else
        return { batch = 1, delay = 0.028 }
    end
end

local function peekCode(code)
    addSpacer(6)
    local refs = {}
    local lines = {}
    for line in (code .. "\n"):gmatch("([^\n]*)\n") do
        table.insert(lines, line)
    end
    local total = #lines

    local profile = getAnimProfile(total)
    local batch = profile.batch
    local delay = profile.delay

    local i = 0
    while i < total do
        for _ = 1, batch do
            i = i + 1
            if i > total then break end
            refs[i] = addLine(lines[i], C.CON_CMD, "info", nil, tostring(i) .. "-")
        end
        if delay > 0 and i < total then
            task.wait(delay)
        end
    end

    addSpacer(6)
    return refs
end

