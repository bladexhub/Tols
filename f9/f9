local CLOSED = false

local function showWindow()
    REOPEN_BTN.Visible = false
    WIN.Visible = true
    WIN_SCALE.Scale = 0.9
    TW(WIN_SCALE, TI_POP, { Scale = 1 })
end

local function hideWindow()
    local t = TWc(WIN_SCALE, TI_FAST, { Scale = 0.9 })
    t.Completed:Connect(function()
        if WIN and WIN.Parent and not CLOSED then
            WIN.Visible = false
            WIN_SCALE.Scale = 1
            REOPEN_BTN.Visible = true
        end
    end)
end

local function shutdown()
    if CLOSED then return end
    CLOSED = true

    dragging = false
    resizing = false
    activeHandle = nil
    dragStart, winStart = nil, nil
    resizeStart, resizeWinPos, resizeWinSize = nil, nil, nil

    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    connections = {}

    pcall(function()
        if loaderThread then task.cancel(loaderThread) end
    end)

    pcall(function()
        if GUI and GUI.Parent then GUI:Destroy() end
    end)
end

