local iconCache = {}
local function getIcon(name)
    if not name then return nil end
    if RBX_ICONS and RBX_ICONS[name] then return RBX_ICONS[name] end
    if not IconLoader then return nil end
    if iconCache[name] ~= nil then return iconCache[name] or nil end
    local ok, id = pcall(IconLoader.GetAny, {"lucide","solar","gravity","sfsymbols"}, name)
    if ok and id then iconCache[name] = id; return id end
    iconCache[name] = false
    return nil
end

local iconSlots = {}
local function applyIcon(holder, name, color, keepColor)
    local id = getIcon(name)
    if not id then return false end
    holder:ClearAllChildren()
    local img = Instance.new("ImageLabel")
    img.Image = id
    if keepColor then
        img.ImageColor3 = Color3.fromRGB(255,255,255)
    else
        img.ImageColor3 = color or Color3.new(1,1,1)
    end
    img.BackgroundTransparency = 1
    img.ScaleType = Enum.ScaleType.Fit
    img.Size = UDim2.new(1, 0, 1, 0)
    img.Parent = holder
    return true
end

local function mkIcon(name, size, color, parent, keepColor)
    local holder = Instance.new("Frame")
    holder.BackgroundTransparency = 1
    holder.Size = UDim2.new(0, size, 0, size)
    holder.Parent = parent
    if not applyIcon(holder, name, color, keepColor) then
        iconSlots[#iconSlots + 1] = {holder = holder, name = name, color = color, keepColor = keepColor}
    end
    return holder
end

