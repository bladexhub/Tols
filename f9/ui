        AutomaticSize = Enum.AutomaticSize.Y
    }, row)

    local numberLabel

    if data.showLineNumbers ~= false then
        numberLabel = Components.Mk("TextLabel", {
            Name = "LineNumber",
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 42, 0, 22),
            Font = Enum.Font.Code,
