[Drag.lua]
local UserInputService = game:GetService("UserInputService")

local Drag = {}

function Drag.Bind(window, titleBar, context)
    local dragging = false
    local dragStart
    local startPosition

    local function validTarget(target)
        if not target then
            return true
        end

        if context.isBlocked and context.isBlocked(target) then
            return false
        end

        if context.inputObjectFilter and context.inputObjectFilter(target) then
            return false
        end

        return true
    end

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if not validTarget(input.Target) then
            return
        end

        dragging = true
        dragStart = input.Position
        startPosition = window.Position
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart

        window.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

return Drag

[Resize.lua]
local UserInputService = game:GetService("UserInputService")

local Resize = {}

function Resize.Bind(window, context)
    local edge = context.resizeEdge or 26
    local minimum = context.minimumSize or Vector2.new(360, 260)

    local handles = {}

    local definitions = {
        TL = {
            Position = UDim2.new(0, 0, 0, 0),
            AnchorPoint = Vector2.new(0, 0),
            Size = UDim2.new(0, edge, 0, edge)
        },
        TR = {
            Position = UDim2.new(1, 0, 0, 0),
            AnchorPoint = Vector2.new(1, 0),
            Size = UDim2.new(0, edge, 0, edge)
        },
        BL = {
            Position = UDim2.new(0, 0, 1, 0),
            AnchorPoint = Vector2.new(0, 1),
            Size = UDim2.new(0, edge, 0, edge)
        },
        BR = {
            Position = UDim2.new(1, 0, 1, 0),
            AnchorPoint = Vector2.new(1, 1),
            Size = UDim2.new(0, edge, 0, edge)
        }
    }

    local active
    local startInput
    local startPosition
    local startSize

    local function createHandle(name, data)
        local handle = Instance.new("TextButton")
        handle.Name = "Resize_" .. name
        handle.BackgroundTransparency = 1
        handle.BorderSizePixel = 0
        handle.Text = ""
        handle.AutoButtonColor = false
        handle.AnchorPoint = data.AnchorPoint
        handle.Position = data.Position
        handle.Size = data.Size
        handle.ZIndex = 20
        handle.Parent = window

        handle.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            active = name
            startInput = input.Position
            startPosition = window.Position
            startSize = window.AbsoluteSize
        end)

        return handle
    end

    for name, data in pairs(definitions) do
        handles[name] = createHandle(name, data)
    end

    UserInputService.InputChanged:Connect(function(input)
        if not active then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - startInput

        local width = startSize.X
        local height = startSize.Y
        local x = startPosition.X.Offset
        local y = startPosition.Y.Offset

        if active == "TR" or active == "BR" then
            width = startSize.X + delta.X
        elseif active == "TL" or active == "BL" then
            width = startSize.X - delta.X
            x = startPosition.X.Offset + delta.X
        end

        if active == "BL" or active == "BR" then
            height = startSize.Y + delta.Y
        elseif active == "TL" or active == "TR" then
            height = startSize.Y - delta.Y
            y = startPosition.Y.Offset + delta.Y
        end

        width = math.max(minimum.X, width)
        height = math.max(minimum.Y, height)

        window.Size = UDim2.fromOffset(width, height)
        window.Position = UDim2.new(
            startPosition.X.Scale,
            x,
            startPosition.Y.Scale,
            y
        )
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            active = nil
        end
    end)

    return handles
end

return Resize

