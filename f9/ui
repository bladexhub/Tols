    local scale = Instance.new("UIScale")
    scale.Scale = 0.96
    scale.Parent = row

    Animations.Play(scale, Animations.Pop, {
        Scale = 1
    })

    return row
end

return ConsoleLine

[Console.lua]
local RunService = game:GetService("RunService")
local Components = require(script.Parent.Components)
local ConsoleLine = require(script.Parent.ConsoleLine)

local Console = {}
Console.__index = Console

function Console.new(parent, context)
    local self = setmetatable({}, Console)

    self.context = context or {}
    self.maxLines = self.context.maxLines or 20000
    self.totalLines = 0
    self.lines = {}

    self.box = Components.Mk("Frame", {
        Name = "ConsoleOutput",
        BackgroundColor3 = self.context.colors.consoleBackground,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, -72),
        LayoutOrder = 1,
        ClipsDescendants = true
    }, parent)

    Components.Corner(self.box, 10)
    Components.Stroke(self.box, self.context.colors.divider, 1)

    self.scroll = Components.Mk("ScrollingFrame", {
        Name = "Console",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = self.context.colors.scrollbar,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
    }, self.box)

    Components.Padding(self.scroll, 8, 8, 8, 8)
    self.layout = Components.VList(self.scroll, 2)

    return self
end

function Console:AddLine(text, color, level, iconName, prefix, options)
    options = options or {}

    self.totalLines += 1

    local row = ConsoleLine.Create(self.scroll, {
        text = text,
        color = color or self.context.colors.text,
        level = level,
        iconName = iconName,
        iconProvider = self.context.iconProvider,
        prefix = prefix,
        divider = options.divider,
        showLineNumbers = options.showLineNumbers ~= false,
        lineNumber = self.totalLines,
        layoutOrder = self.totalLines
    })

    table.insert(self.lines, row)

    while #self.lines > self.maxLines do
        local old = table.remove(self.lines, 1)
        if old then
            old:Destroy()
        end
    end

    task.defer(function()
        if self.scroll and self.scroll.Parent then
            RunService.Heartbeat:Wait()
            self.scroll.CanvasPosition = Vector2.new(
                0,
                math.max(0, self.scroll.AbsoluteCanvasSize.Y - self.scroll.AbsoluteWindowSize.Y)
            )
        end
    end)

    return row
end

function Console:PeekCode(code)
    for line in tostring(code):gmatch("[^\r\n]+") do
        self:AddLine(line, self.context.colors.consoleCode, "info", self.context.icons.chevron)
    end
end

function Console:Clear()
    for _, object in ipairs(self.lines) do
        if object then
            object:Destroy()
        end
    end
    table.clear(self.lines)
    self.totalLines = 0
end

return Console

