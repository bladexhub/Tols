    return button
end

return ReopenButton

[Window.lua]
local UserInputService = game:GetService("UserInputService")
local Components = require(script.Parent.Components)
local Animations = require(script.Parent.Animations)
local TitleBar = require(script.Parent.TitleBar)
local Console = require(script.Parent.Console)
local Input = require(script.Parent.Input)
local RunButton = require(script.Parent.RunButton)
local Drag = require(script.Parent.Drag)
local Resize = require(script.Parent.Resize)

local Window = {}
Window.__index = Window

function Window.Create(root, context)
    local self = setmetatable({}, Window)

    self.context = context
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)

    local width = math.min(context.maxWidth or 620, math.max(context.minWidth or 360, viewport.X - 16))
    local height = math.min(context.maxHeight or 420, math.max(context.minHeight or 260, viewport.Y - 40))

    local x = math.floor((viewport.X - width) / 2)
    local y = math.floor((viewport.Y - height) / 2)

    self.window = Components.Mk("Frame", {
        Name = "MainWindow",
        BackgroundColor3 = context.colors.window,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(width, height),
        ClipsDescendants = false
    }, root)

    Components.Corner(self.window, 16)
    Components.Stroke(self.window, context.colors.border, 1)

    self.scale = Instance.new("UIScale")
    self.scale.Scale = 1
    self.scale.Parent = self.window

    self.titleBar = TitleBar.Create(self.window, context)

    self.content = Components.Mk("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 8, 0, 42),
        Size = UDim2.new(1, -16, 1, -50)
    }, self.window)

    self.console = Console.new(self.content, context)

    self.input = Input.Create(self.content, context)
    self.runButton = RunButton.Create(self.input.Frame, {
        colors = context.colors,
        icons = context.icons,
        iconProvider = context.iconProvider,
        input = self.input,
        onRun = context.onRun
    })

    self.input.Frame.Size = UDim2.new(1, 0, 0, 36)

    Drag.Bind(self.window, self.titleBar.Frame, {
        isBlocked = function(target)
            if target:IsDescendantOf(self.titleBar.Close) then
                return true
            end
            if target:IsDescendantOf(self.titleBar.Minimize) then
                return true
            end
            if target:IsDescendantOf(self.input.Frame) then
                return true
            end
            return false
        end
    })

    Resize.Bind(self.window, {
        resizeEdge = context.resizeEdge or 26,
        minimumSize = Vector2.new(
            context.minWidth or 360,
            context.minHeight or 260
        )
    })

    self.titleBar.Close.MouseButton1Click:Connect(function()
        if context.onClose then
            context.onClose()
        else
            self:Hide()
        end
    end)

    self.titleBar.Minimize.MouseButton1Click:Connect(function()
        if context.onMinimize then
            context.onMinimize()
        else
            self:Hide()
        end
    end)

    return self
end

function Window:Show()
    self.window.Visible = true
    Animations.Scale(self.window, 1, Animations.Pop)
end

function Window:Hide()
    self.window.Visible = false
end

function Window:Toggle()
    self.window.Visible = not self.window.Visible
    if self.window.Visible then
        Animations.Scale(self.window, 1, Animations.Pop)
    end
end

function Window:Destroy()
    if self.window then
        self.window:Destroy()
        self.window = nil
    end
end

return Window

[Init.lua]
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local Components = require(script.Components)
local Window = require(script.Window)
local ReopenButton = require(script.ReopenButton)

local UI = {}

local defaultColors = {
    window = Color3.fromRGB(8, 8, 10),
    header = Color3.fromRGB(12, 12, 15),
    divider = Color3.fromRGB(38, 38, 44),
    border = Color3.fromRGB(45, 45, 52),
    button = Color3.fromRGB(22, 22, 27),
    buttonHover = Color3.fromRGB(32, 32, 39),
    text = Color3.fromRGB(235, 235, 240),
    placeholder = Color3.fromRGB(105, 105, 115),
    accent = Color3.fromRGB(137, 180, 250),
    consoleBackground = Color3.fromRGB(7, 7, 9),
    consoleCode = Color3.fromRGB(185, 190, 205),
    input = Color3.fromRGB(15, 15, 19),
    scrollbar = Color3.fromRGB(70, 70, 80),
    run = Color3.fromRGB(32, 105, 65),
    runHover = Color3.fromRGB(40, 125, 77),
    runStroke = Color3.fromRGB(55, 145, 90),
    runText = Color3.fromRGB(235, 255, 240),
    consoleSystem = Color3.fromRGB(150, 185, 245)
}

local defaultIcons = {
    chevron = "chevron-right",
    cmd = "terminal",
    error = "x",
    warn = "alert-triangle",
    info = "info",
    check = "check",
    ret = "corner-down-left",
    shield = "shield",
    gamepad = "gamepad-2",
    logo = "bladex-hud-logo"
}

local function cleanup()
    for _, container in ipairs({CoreGui, Players.LocalPlayer:FindFirstChild("PlayerGui")}) do
        if container then
            for _, name in ipairs({
                "__DexRoot",
                "__DexGui",
                "DarkDexV3",
                "DarkDex",
                "__F9Gui"
            }) do
                local old = container:FindFirstChild(name)
                if old then
                    pcall(function()
                        old:Destroy()
                    end)
                end
            end
        end
    end
end

function UI.Create(options)
    options = options or {}

    cleanup()

    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui", 10)
    local root = playerGui

    pcall(function()
        root = CoreGui
    end)

    local gui = Components.Mk("ScreenGui", {
        Name = "__DexRoot",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, root)

    local colors = table.clone(defaultColors)
    for key, value in pairs(options.colors or {}) do
        colors[key] = value
    end

    local icons = table.clone(defaultIcons)
    for key, value in pairs(options.icons or {}) do
        icons[key] = value
    end

    local state = {
        gui = gui,
        window = nil,
        reopened = false,
        closed = false
    }

    local context = {
        title = options.title or "BLADEX HUD",
        colors = colors,
        icons = icons,
        iconProvider = options.iconProvider,
        onRun = options.onRun,
        onEnter = options.onEnter,
        onClose = function()
            state.closed = true
            if options.onClose then
                options.onClose()
            else
                if state.window then
                    state.window:Hide()
                end
            end
        end,
        onMinimize = function()
            if state.window then
                state.window:Hide()
            end
            if options.onMinimize then
                options.onMinimize()
            end
        end,
        onReopen = function()
            state.closed = false
            if state.window then
                state.window:Show()
            end
            if options.onReopen then
                options.onReopen()
            end
        end,
        maxLines = options.maxLines or 20000,
        maxWidth = options.maxWidth or 620,
        maxHeight = options.maxHeight or 420,
        minWidth = options.minWidth or 360,
        minHeight = options.minHeight or 260,
        resizeEdge = options.resizeEdge or 26
    }

    state.window = Window.Create(gui, context)

    state.reopenButton = ReopenButton.Create(gui, context)

    function state:AddLine(text, color, level, iconName, prefix, lineOptions)
        if self.window and self.window.console then
            return self.window.console:AddLine(
                text,
                color,
                level,
                iconName,
                prefix,
                lineOptions
            )
        end
    end

    function state:PeekCode(code)
        if self.window and self.window.console then
            return self.window.console:PeekCode(code)
        end
    end

    function state:ClearConsole()
        if self.window and self.window.console then
            self.window.console:Clear()
        end
    end

    function state:GetInput()
        if self.window and self.window.input then
            return self.window.input.TextBox
        end
    end

    function state:Show()
        self.closed = false
        self.window:Show()
    end

    function state:Hide()
        self.window:Hide()
    end

    function state:Toggle()
        self.window:Toggle()
    end

    function state:Destroy()
        self.closed = true
        if self.gui then
            self.gui:Destroy()
        end
    end

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if input.KeyCode == Enum.KeyCode.F9 then
            if state.window then
                state.window:Toggle()
            end
        end
    end)

    return state
end

return UI


