local BLADEX = getgenv().__BLADEX
local Utils  = BLADEX.Utils
local State  = BLADEX.State
local Events = BLADEX.Events
local HTTP   = BLADEX.HTTP
local Logger = BLADEX.Logger

local Models = { list = {}, loading = false, lastError = nil }

local function num(v)
    return tonumber(v) or 0
end

local function isFreeModel(pricing)
    if type(pricing) ~= "table" then return false end
    return num(pricing.prompt) == 0 and num(pricing.completion) == 0
end

local OPEN_PATTERNS = {
    "qwen", "llama", "gemma", "mistral", "mixtral",
    "deepseek", "phi", "nemotron", "glm", "gpt-oss",
    "granite", "olmo", "yi-", "internlm", "minimax",
    "kimi", "hunyuan", "mimo", "lfm", "smollm",
    "starcoder", "codestral", "command-r", "qwq",
    "qwen3", "qwen2", "llama-3", "llama3",
}

local function isOpenModel(model)
    if type(model) ~= "table" or type(model.id) ~= "string" then
        return false
    end

    local id = string.lower(model.id)
    local name = string.lower(tostring(model.name or ""))

    for _, pattern in ipairs(OPEN_PATTERNS) do
        if id:find(pattern, 1, true) or name:find(pattern, 1, true) then
            return true
        end
    end

    return false
end

local function getPrice(pricing)
    pricing = type(pricing) == "table" and pricing or {}
    return {
        input = num(pricing.prompt),
        output = num(pricing.completion),
        request = num(pricing.request),
        image = num(pricing.image),
        cacheRead = num(pricing.input_cache_read),
        cacheWrite = num(pricing.input_cache_write),
    }
end

local function modelCategory(model)
    if model.free then
        return "free"
    elseif model.open then
        return "open"
    end
    return "paid"
end

local function supports(model, value)
    local params = model.supported_parameters
    if type(params) ~= "table" then return false end

    for _, item in ipairs(params) do
        if tostring(item) == value then
            return true
        end
    end

    return false
end

local function buildModel(m)
    local pricing = type(m.pricing) == "table" and m.pricing or {}
    local free = isFreeModel(pricing)
    local open = isOpenModel(m)
    local price = getPrice(pricing)

    local context = num(m.context_length)

    local item = {
        id = m.id,
        name = m.name or m.id,
        context = context,

        free = free,
        open = open,
        paid = not free,

        category = free and "free" or (open and "open" or "paid"),

        pricing = pricing,
        price = price,

        description = m.description or "",
        architecture = m.architecture or {},
        topProvider = m.top_provider or {},
        created = num(m.created),
        canonicalSlug = m.canonical_slug or m.id,

        capabilities = {
            vision = false,
            tools = supports(m, "tools"),
            reasoning = supports(m, "reasoning"),
            structuredOutput = supports(m, "structured_outputs"),
            json = supports(m, "response_format"),
        },

        supportedParameters = m.supported_parameters or {},
    }

    local arch = item.architecture
    if type(arch) == "table" then
        local inputModalities = arch.input_modalities
        if type(inputModalities) == "table" then
            for _, modality in ipairs(inputModalities) do
                if tostring(modality) == "image" then
                    item.capabilities.vision = true
                    break
                end
            end
        end
    end

    return item
end


function Models:Fetch()
    if self.loading then
        return { success = false, error = { code = "LOADING", message = "Ya cargando." } }
    end

    local key = State:Get("settings.apiKey")
    if Utils.IsEmpty(key) then
        self.lastError = "Sin API Key"
        return { success = false, error = { code = "NO_KEY", message = "Configura tu API Key." } }
    end

    self.loading = true
    Events:Emit("ModelsLoading", true)

    local requestOk, resp = pcall(function()
        return HTTP:Call({
            Url     = "https://openrouter.ai/api/v1/models",
            Method  = "GET",
            Headers = {
                ["Authorization"] = "Bearer " .. key,
                ["Content-Type"]  = "application/json",
            },
            timeout = 25,
        })
    end)

    self.loading = false

    if not requestOk then
        self.lastError = Utils.Sanitize(resp)
        Events:Emit("ModelsFailed", self.lastError)
        return { success = false, error = { code = "INTERNAL", message = self.lastError } }
    end
    if not resp.success then
        self.lastError = resp.error and resp.error.message or "Error de red"
        Events:Emit("ModelsFailed", self.lastError)
        return resp
    end

    local dec = Utils.Decode(resp.body)
    if not dec or type(dec.data) ~= "table" then
        self.lastError = "Respuesta invalida"
        Events:Emit("ModelsFailed", self.lastError)
        return { success = false, error = { code = "BAD_JSON", message = "Respuesta invalida." } }
    end

    local list = {}

    for _, m in ipairs(dec.data) do
        if type(m) == "table" and type(m.id) == "string" and m.id ~= "" then
            list[#list + 1] = buildModel(m)
        end
    end

    table.sort(list, function(a, b)
        local ca, cb = modelCategory(a), modelCategory(b)

        local rank = {
            free = 1,
            open = 2,
            paid = 3,
        }

        if rank[ca] ~= rank[cb] then
            return rank[ca] < rank[cb]
        end

        if a.context ~= b.context then
            return a.context > b.context
        end

        if a.created ~= b.created then
            return a.created > b.created
        end

        return a.id < b.id
    end)


    self.list = list
    State:Set("models", list)
    self.lastError = nil

    if Utils.IsEmpty(State:Get("settings.model")) and #list > 0 then
        State:Set("settings.model", list[1].id)
    end

    Events:Emit("ModelsLoaded", list)
    Logger:Info("Modelos cargados: %d", #list)
    return { success = true, count = #list }
end

function Models:GetByCategory(category)
    category = string.lower(tostring(category or ""))
    local result = {}

    for _, model in ipairs(self.list) do
        if string.lower(tostring(model.category)) == category then
            result[#result + 1] = model
        end
    end

    return result
end

function Models:GetFree()
    return self:GetByCategory("free")
end

function Models:GetOpen()
    return self:GetByCategory("open")
end

function Models:GetPaid()
    return self:GetByCategory("paid")
end

function Models:Find(id)
    if type(id) ~= "string" then return nil end

    for _, model in ipairs(self.list) do
        if model.id == id then
            return model
        end
    end

    return nil
end

BLADEX.Models = Models
return Models
