local BLADEX = getgenv().__BLADEX
local Utils  = BLADEX.Utils
local State  = BLADEX.State
local Events = BLADEX.Events
local HTTP   = BLADEX.HTTP
local Logger = BLADEX.Logger

local Models = { list = {}, loading = false, lastError = nil }

local function num(v) return tonumber(v) or 0 end
local function isFreeModel(pricing)
    if type(pricing) ~= "table" then return false end
    return num(pricing.prompt) == 0 and num(pricing.completion) == 0
end

local OPEN_PATTERNS = {
    "qwen", "llama", "gemma", "mistral", "mixtral",
    "deepseek", "phi", "nemotron", "glm", "gpt-oss",
    "granite", "olmo", "yi-", "internlm", "minimax",
    "kimi", "hunyuan", "mimo", "lfm", "smollm",
    "starcoder", "codestral", "command-r", "qwq",
    "qwen3", "qwen2", "llama-3", "llama3",
}
local function isOpenModel(model)
    if type(model) ~= "table" or type(model.id) ~= "string" then return false end
    local id = string.lower(model.id)
    local name = string.lower(tostring(model.name or ""))
    for _, pattern in ipairs(OPEN_PATTERNS) do
        if id:find(pattern, 1, true) or name:find(pattern, 1, true) then return true end
    end
    return false
end

local function getPrice(pricing)
    pricing = type(pricing) == "table" and pricing or {}
    return { input = num(pricing.prompt), output = num(pricing.completion), request = num(pricing.request) }
end

local function supports(model, value)
    local params = model.supported_parameters
    if type(params) ~= "table" then return false end
    for _, item in ipairs(params) do if tostring(item) == value then return true end end
    return false
end

local function buildModel(m)
    local pricing = type(m.pricing) == "table" and m.pricing or {}
    local free = isFreeModel(pricing)
    local open = isOpenModel(m)
    local price = getPrice(pricing)
    local context = num(m.context_length)

    local item = {
        id = m.id, name = m.name or m.id, context = context,
        free = free, open = open, paid = not free,
        category = free and "free" or (open and "open" or "paid"),
        pricing = pricing, price = price,
        description = m.description or "",
        architecture = m.architecture or {},
        topProvider = m.top_provider or {},
        created = num(m.created),
        canonicalSlug = m.canonical_slug or m.id,
        capabilities = { vision = false, tools = supports(m, "tools"), reasoning = supports(m, "reasoning"),
            structuredOutput = supports(m, "structured_outputs"), json = supports(m, "response_format") },
        supportedParameters = m.supported_parameters or {},
    }
    local arch = item.architecture
    if type(arch) == "table" and type(arch.input_modalities) == "table" then
        for _, modality in ipairs(arch.input_modalities) do
            if tostring(modality) == "image" then item.capabilities.vision = true break end
        end
    end
    return item
end

-- Convierte entrada simple {id, free} en modelo enriquecido
local function simpleModel(id, free)
    return {
        id = id, name = id, context = 0,
        free = free == true or id:find(":free") ~= nil,
        open = isOpenModel({ id = id }), paid = false,
        category = (free == true or id:find(":free") ~= nil) and "free" or "open",
        pricing = {}, price = { input = 0, output = 0, request = 0 },
        description = "", architecture = {}, topProvider = {}, created = 0, canonicalSlug = id,
        capabilities = { vision = false, tools = false, reasoning = false, structuredOutput = false, json = false },
        supportedParameters = {},
    }
end

function Models:Fetch()
    if self.loading then return { success = false, error = { code = "LOADING", message = "Ya cargando." } } end

    local Providers = BLADEX.Providers or BLADEX.OpenRouter
    local providerId = State:Get("settings.provider") or "openrouter"
    local keys = State:Get("settings.apiKeys") or {}
    local key = keys[providerId] or State:Get("settings.apiKey") or ""

    if Utils.IsEmpty(key) then
        self.lastError = "Sin API Key para " .. providerId
        return { success = false, error = { code = "NO_KEY", message = "Configura tu API Key." } }
    end

    self.loading = true
    Events:Emit("ModelsLoading", true)

    local list = {}

    -- 1) Intentar descubrimiento dinámico del proveedor
    if Providers and type(Providers.FetchModels) == "function" then
        local ok, dynamic = pcall(function() return Providers:FetchModels(providerId, key) end)
        if ok and type(dynamic) == "table" and #dynamic > 0 then
            for _, m in ipairs(dynamic) do
                list[#list + 1] = simpleModel(m.id, m.free)
            end
        end
    end

    -- 2) Fallback: usar lista estática del proveedor
    if #list == 0 and Providers and type(Providers.GetModels) == "function" then
        local statics = Providers:GetModels(providerId)
        for _, id in ipairs(statics) do list[#list + 1] = simpleModel(id, false) end
    end

    -- 3) Si es OpenRouter, enriquecer con precios reales (mantiene tu lógica actual)
    if providerId == "openrouter" and #list > 0 then
        local reqOk, resp = pcall(function()
            return HTTP:Call({
                Url = "https://openrouter.ai/api/v1/models", Method = "GET",
                Headers = { ["Authorization"] = "Bearer " .. key, ["Content-Type"] = "application/json" },
                timeout = 25,
            })
        end)
        if reqOk and resp and resp.success then
            local dec = Utils.Decode(resp.body)
            if dec and type(dec.data) == "table" then
                local enriched = {}
                for _, m in ipairs(dec.data) do
                    if type(m) == "table" and type(m.id) == "string" and m.id ~= "" then
                        enriched[#enriched + 1] = buildModel(m)
                    end
                end
                if #enriched > 0 then list = enriched end
            end
        end
    end

    self.loading = false

    if #list == 0 then
        self.lastError = "Sin modelos disponibles para " .. providerId
        Events:Emit("ModelsFailed", self.lastError)
        return { success = false, error = { code = "EMPTY", message = self.lastError } }
    end

    table.sort(list, function(a, b)
        local rank = { free = 1, open = 2, paid = 3 }
        local ca, cb = rank[a.category] or 4, rank[b.category] or 4
        if ca ~= cb then return ca < cb end
        if a.context ~= b.context then return a.context > b.context end
        if a.created ~= b.created then return a.created > b.created end
        return a.id < b.id
    end)

    self.list = list
    State:Set("models", list)
    self.lastError = nil

    if Utils.IsEmpty(State:Get("settings.model")) and #list > 0 then
        State:Set("settings.model", list[1].id)
    end

    Events:Emit("ModelsLoaded", list)
    Logger:Info("Modelos cargados de %s: %d", providerId, #list)
    return { success = true, count = #list, provider = providerId }
end

function Models:GetByCategory(category)
    category = string.lower(tostring(category or ""))
    local result = {}
    for _, model in ipairs(self.list) do
        if string.lower(tostring(model.category)) == category then result[#result + 1] = model end
    end
    return result
end
function Models:GetFree() return self:GetByCategory("free") end
function Models:GetOpen() return self:GetByCategory("open") end
function Models:GetPaid() return self:GetByCategory("paid") end
function Models:Find(id)
    if type(id) ~= "string" then return nil end
    for _, model in ipairs(self.list) do if model.id == id then return model end end
    return nil
end

BLADEX.Models = Models
return Models
