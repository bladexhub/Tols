local ENV = getgenv().__BLADEX
if not ENV then error("[Particles] __BLADEX no disponible.") end

local UI          = ENV.UI
local State       = ENV.State
local Events      = ENV.Events
local new         = ENV.new
local corner      = ENV.corner

local RunService  = game:GetService("RunService")

local Particles = {}
Particles.__index = Particles

local MIN_COUNT = 4
local MAX_COUNT = 28

local function getIntensity() return tonumber(State:Get("settings.particleIntensity")) or 0.60 end
local function getSpeed()     return tonumber(State:Get("settings.particleSpeed"))     or 0.70 end
local function getSize()      return tonumber(State:Get("settings.particleSize"))      or 3    end
local function getCount()     return tonumber(State:Get("settings.particleCount"))     or 20   end

local function dotTransparency(intensity)
    return math.clamp(0.35 - intensity * 0.3, 0.05, 0.75)
end

local function lineTransparency(intensity)
    return math.clamp(0.85 - intensity * 0.2, 0.5, 0.98)
end

function Particles.new(parent, w, h, count, color)
    count = math.clamp(math.floor(tonumber(count) or 20), MIN_COUNT, MAX_COUNT)

    local self = setmetatable({}, Particles)
    self.parent    = parent
    self.w, self.h = w, h
    self.color     = color or UI.Theme.accent
    self.count     = count
    self.dots      = {}
    self.lines     = {}
    self.running   = false

    self.intensity = getIntensity()
    self.speed     = getSpeed()
    self.size      = getSize()

    self.lowFpsCheck  = 0
    self.lowFpsFrames = 0
    self.lowFpsTime   = 0
    self._fpsWarned   = false

    self.canvas = new("Frame", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ClipsDescendants       = true,
        ZIndex                 = 1,
    }, parent)
    self.canvas.Name = "ParticleCanvas"
    corner(self.canvas, UI.Dim.radius)

    self:_ensureDots(count)
    self:_ensureLines(80)

    self.conn = RunService.RenderStepped:Connect(function()
        if self.running then self:update() end
    end)

    return self
end

function Particles:_ensureDots(target)
    target = math.clamp(math.floor(target or self.count or 20), MIN_COUNT, MAX_COUNT)

    while #self.dots < target do
        local dot = new("Frame", {
            Size                   = UDim2.fromOffset(self.size, self.size),
            BackgroundColor3       = self.color,
            BackgroundTransparency = dotTransparency(self.intensity),
            BorderSizePixel        = 0,
            ZIndex                 = 1,
        }, self.canvas)
        corner(dot, 2)
        local x, y = math.random(0, self.w), math.random(0, self.h)
        dot.Position = UDim2.fromOffset(x, y)

        self.dots[#self.dots + 1] = {
            frame = dot,
            x = x, y = y,
            vx = (math.random() - 0.5) * self.speed * 3,
            vy = (math.random() - 0.5) * self.speed * 3,
        }
    end

    while #self.dots > target do
        local d = table.remove(self.dots)
        if d and d.frame then d.frame:Destroy() end
    end

    self.count = target
end

function Particles:_ensureLines(target)
    while #self.lines < target do
        self.lines[#self.lines + 1] = new("Frame", {
            BackgroundColor3       = self.color,
            BackgroundTransparency = lineTransparency(self.intensity),
            BorderSizePixel        = 0,
            Visible                = false,
            ZIndex                 = 1,
        }, self.canvas)
    end
    while #self.lines > target do
        local l = table.remove(self.lines)
        if l then l:Destroy() end
    end
end

function Particles:SetColor(color)
    if not color then return end
    self.color = color
    for _, d in ipairs(self.dots) do
        d.frame.BackgroundColor3 = color
    end
    for _, l in ipairs(self.lines) do
        l.BackgroundColor3 = color
    end
end

function Particles:update()
    local now = os.clock()
    local dt = now - (self.lowFpsCheck or now)
    self.lowFpsCheck = now

    if dt > 0 then
        self.lowFpsFrames = self.lowFpsFrames + 1
        self.lowFpsTime   = self.lowFpsTime + dt
        if self.lowFpsTime >= 4 then
            local fps = self.lowFpsFrames / self.lowFpsTime
            if fps < 20 and not self._fpsWarned then
                self._fpsWarned = true
                Events:Emit("LowPerformanceAuto", true)
                if State:Get("settings.lowPerformance") ~= true then
                    State:Set("settings.lowPerformance", true)
                end
                self:SetEnabled(false)
            end
            self.lowFpsFrames, self.lowFpsTime = 0, 0
        end
    end

    local dots = self.dots
    local n = #dots
    local w, h = self.w, self.h
    for i = 1, n do
        local d = dots[i]
        d.x = d.x + d.vx
        d.y = d.y + d.vy
        if d.x < 0  then d.x = 0  d.vx = -d.vx end
        if d.x > w  then d.x = w  d.vx = -d.vx end
        if d.y < 0  then d.y = 0  d.vy = -d.vy end
        if d.y > h  then d.y = h  d.vy = -d.vy end
        d.frame.Position = UDim2.fromOffset(d.x, d.y)
    end

    local maxDist  = 160
    local maxDist2 = maxDist * maxDist
    local li = 0

    for i = 1, n do
        local a = dots[i]
        for j = i + 1, n do
            local b = dots[j]
            local dx, dy = b.x - a.x, b.y - a.y
            local d2 = dx * dx + dy * dy
            if d2 <= maxDist2 then
                li = li + 1
                if li > #self.lines then break end
                local line  = self.lines[li]
                local dist  = math.sqrt(d2)
                local angle = math.atan2(dy, dx) -- CORREGIDO: atan2 en lugar de atan
                local midX  = (a.x + b.x) / 2
                local midY  = (a.y + b.y) / 2
                line.Size     = UDim2.fromOffset(dist, 1)
                line.Position = UDim2.fromOffset(midX - dist / 2, midY)
                line.Rotation = math.deg(angle)
                line.BackgroundTransparency = 0.80 + (dist / maxDist) * 0.15
                line.Visible  = true
            end
        end
    end

    for k = li + 1, #self.lines do
        self.lines[k].Visible = false
    end
end

function Particles:SetEnabled(enabled)
    self.running = enabled == true
    if self.canvas then self.canvas.Visible = self.running end
    Events:Emit("ParticlesToggled", self.running)
end

function Particles:ApplySettings()
    self.intensity = getIntensity()
    self.speed     = getSpeed()
    self.size      = getSize()

    local target = getCount()
    if target ~= self.count then
        self:_ensureDots(target)
    end

    for _, d in ipairs(self.dots) do
        d.vx = (math.random() - 0.5) * self.speed * 3
        d.vy = (math.random() - 0.5) * self.speed * 3
        d.frame.Size = UDim2.fromOffset(self.size, self.size)
        d.frame.BackgroundTransparency = dotTransparency(self.intensity)
    end
    for _, line in ipairs(self.lines) do
        line.BackgroundTransparency = lineTransparency(self.intensity)
    end

    self._fpsWarned = false
end

function Particles:destroy()
    self.running = false
    if self.conn then self.conn:Disconnect() end
    if self.canvas then self.canvas:Destroy() end
    self.dots  = {}
    self.lines = {}
end

return Particles
