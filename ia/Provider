local function getActiveKey()
    local providerId = State:Get("settings.provider") or "openrouter"
    local keys = State:Get("settings.apiKeys") or {}
    local key = keys[providerId]
    if Utils.IsEmpty(key) then key = State:Get("settings.apiKey") end
    return providerId, key or ""
end

function Providers:Get(id) return self.config[id] end
function Providers:List()
    local out = {}
    for id, cfg in pairs(self.config) do out[#out+1] = { id = id, name = cfg.name } end
    table.sort(out, function(a,b) return a.name < b.name end)
    return out
end
function Providers:GetModels(id) local c = self.config[id] return c and Utils.Copy(c.models) or {} end
function Providers:GetFallbacks(id) local c = self.config[id] return c and Utils.Copy(c.fallbacks) or {} end

function Providers:FetchModels(providerId, apiKey)
    local cfg = self.config[providerId]
    if not cfg or not cfg.discover or not cfg.discover.enabled then return nil end
    if Utils.IsEmpty(apiKey) then return nil end
    local url = cfg.discover.url:gsub("{KEY}", apiKey):gsub("{ENDPOINT}", cfg.endpoint)
    local ok, resp = pcall(function()
        return HTTP:Call({ Url = url, Method = "GET", Headers = { ["Content-Type"] = "application/json" }, timeout = 20 })
    end)
    if not ok or not resp or not resp.success then return nil end
    local data = Utils.Decode(resp.body)
    if not data or type(data.data) ~= "table" then return nil end
    local models = {}
    for _, m in ipairs(data.data) do
        local id = m.id or m.name or ""
        if cfg.discover.stripPrefix and id:sub(1, #cfg.discover.stripPrefix) == cfg.discover.stripPrefix then
            id = id:sub(#cfg.discover.stripPrefix + 1)
        end
        if cfg.discover.filter and not id:find(cfg.discover.filter, 1, true) then
            -- skip
        else
            models[#models+1] = { id = id, free = (id:find(":free") ~= nil) or (cfg.kind == "gemini") }
        end
    end
    if #models == 0 then return nil end
    table.sort(models, function(a,b) return a.id < b.id end)
    return models
end

function Providers:_openaiChat(cfg, apiKey, modelId, messages, temp, maxT)
    local url = cfg.endpoint .. "/chat/completions"
    local body = Utils.Encode({ model = modelId, messages = messages, temperature = temp, max_tokens = maxT })
    if not body then return { success = false, error = { code = "ENCODE_FAILED", message = "No se pudo codificar" } } end
    local headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. apiKey }
    if cfg.endpoint:find("openrouter") then
        headers["HTTP-Referer"] = "https://bladex.local"
        headers["X-Title"] = "BLADEX IA"
    end
    local result = HTTP:Call({ Url = url, Method = "POST", Headers = headers, Body = body, timeout = 60 })
    if not result.success then
        return { success = false, error = result.error or { code = "REQUEST_FAILED", message = "Error de red" }, statusCode = result.statusCode }
    end
    local data = Utils.Decode(result.body)
    if not data then return { success = false, error = { code = "DECODE_FAILED", message = "Respuesta inválida" } } end
    if data.error then return { success = false, error = { code = tostring(data.error.code or "API_ERROR"), message = data.error.message or "Error de API" } } end
    local content = data.choices and data.choices[1] and data.choices[1].message and data.choices[1].message.content
    if type(content) ~= "string" or content == "" then
        return { success = false, error = { code = "EMPTY", message = "La API no devolvió contenido" } }
    end
    return { success = true, content = content, model = data.model or modelId, usage = data.usage or {} }
end

function Providers:_geminiChat(cfg, apiKey, modelId, messages, temp, maxT)
    local url = cfg.endpoint .. modelId .. ":generateContent?key=" .. apiKey
    local systemInstruction, contents = nil, {}
    for _, m in ipairs(messages) do
        if m.role == "system" then
            systemInstruction = systemInstruction and (systemInstruction .. "\n" .. m.content) or m.content
        elseif m.role == "user" then
            contents[#contents+1] = { role = "user", parts = { { text = m.content } } }
        elseif m.role == "assistant" then
            contents[#contents+1] = { role = "model", parts = { { text = m.content } } }
        end
    end
    if #contents == 0 then contents[1] = { role = "user", parts = { { text = "Hola" } } } end
    local payload = { contents = contents, generationConfig = { temperature = temp, maxOutputTokens = maxT } }
    if systemInstruction then payload.systemInstruction = { parts = { { text = systemInstruction } } } end
    local body = Utils.Encode(payload)
    if not body then return { success = false, error = { code = "ENCODE_FAILED", message = "No se pudo codificar" } } end
    local result = HTTP:Call({ Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body, timeout = 60 })
    if not result.success then
        return { success = false, error = result.error or { code = "REQUEST_FAILED", message = "Error de red" }, statusCode = result.statusCode }
    end
    local data = Utils.Decode(result.body)
    if not data then return { success = false, error = { code = "DECODE_FAILED", message = "Respuesta inválida" } } end
    if data.error then return { success = false, error = { code = tostring(data.error.code or "API_ERROR"), message = data.error.message or "Error de API" } } end
    local content = nil
    if data.candidates and data.candidates[1] and data.candidates[1].content and data.candidates[1].content.parts then
        local buf = {}
        for _, p in ipairs(data.candidates[1].content.parts) do if p.text then buf[#buf+1] = p.text end end
        content = table.concat(buf)
    end
    if type(content) ~= "string" or content == "" then
        return { success = false, error = { code = "EMPTY", message = "La API no devolvió contenido" } }
    end
    return { success = true, content = content, model = modelId, usage = data.usageMetadata or {} }
end

-- Firma compatible con el antiguo OpenRouter:Chat({ model, messages, temperature, max_tokens })
function Providers:Chat(req)
    req = req or {}
    local providerId, apiKey = getActiveKey()
    local cfg = self.config[providerId]
    if not cfg then return { success = false, error = { code = "INVALID_PROVIDER", message = "Proveedor desconocido: " .. tostring(providerId) } } end
    if Utils.IsEmpty(apiKey) then return { success = false, error = { code = "NO_KEY", message = "Falta la API Key para " .. cfg.name } } end
    if Utils.IsEmpty(req.model) then return { success = false, error = { code = "NO_MODEL", message = "Falta el modelo para " .. cfg.name } } end
    local temp = math.clamp(tonumber(req.temperature) or 0.7, 0, 2)
    local maxT = math.max(1, math.floor(tonumber(req.max_tokens) or tonumber(req.maxTokens) or 3000))
    if cfg.kind == "gemini" then
        return self:_geminiChat(cfg, apiKey, req.model, req.messages or {}, temp, maxT)
    else
        return self:_openaiChat(cfg, apiKey, req.model, req.messages or {}, temp, maxT)
    end
end

function Providers:TestConnection(providerId, apiKey)
    providerId = providerId or (State:Get("settings.provider") or "openrouter")
    apiKey = apiKey or getActiveKey()
    if Utils.IsEmpty(apiKey) then return { success = false, error = { code = "NO_KEY", message = "Falta API Key" } } end
    local cfg = self.config[providerId]
    if not cfg then return { success = false, error = { code = "INVALID_PROVIDER", message = "Proveedor desconocido" } } end
    local testModel = cfg.fallbacks[1] or cfg.models[1]
    if not testModel then return { success = false, error = { code = "NO_MODEL", message = "Sin modelos" } } end
    local r = self:Chat({ model = testModel, messages = { { role = "user", content = "ping" } }, temperature = 0, max_tokens = 5 })
    if r.success then return { success = true, message = "Conectado a " .. cfg.name } end
    return r
end

