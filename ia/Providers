--api

local BLADEX = getgenv().__BLADEX
local Utils  = BLADEX.Utils
local State  = BLADEX.State
local HTTP   = BLADEX.HTTP

local OpenRouter = { url = "https://openrouter.ai/api/v1/chat/completions" }

function OpenRouter:TestConnection()
    local key = State:Get("settings.apiKey")
    if Utils.IsEmpty(key) then
        return { success = false, error = { code = "NO_KEY", message = "Configura tu API Key." } }
    end
    local resp = HTTP:Call({
        Url     = "https://openrouter.ai/api/v1/models",
        Method  = "GET",
        Headers = {
            ["Authorization"] = "Bearer " .. key,
            ["Content-Type"]  = "application/json",
        },
        timeout = 20,
    })
    if not resp.success then return resp end
    return { success = true, message = "Conectado" }
end

function OpenRouter:Chat(req)
    req = req or {}
    local key = State:Get("settings.apiKey")
    if Utils.IsEmpty(key) then
        return { success = false, error = { code = "NO_KEY", message = "Configura tu API Key." } }
    end
    if Utils.IsEmpty(req.model) then
        return { success = false, error = { code = "NO_MODEL", message = "Configura un modelo." } }
    end

    local body = {
        model       = req.model,
        messages    = req.messages or {},
        temperature = req.temperature or 0.7,
        max_tokens  = req.maxTokens or 2048,
    }

    local enc = Utils.Encode(body)
    if not enc then
        return { success = false, error = { code = "JSON_FAIL", message = "Fallo codificando JSON." } }
    end

    local resp = HTTP:Call({
        Url    = self.url,
        Method = "POST",
        Headers = {
            ["Authorization"] = "Bearer " .. key,
            ["Content-Type"]  = "application/json",
            ["HTTP-Referer"]  = "https://bladex.local",
            ["X-Title"]       = "BLADEX IA",
        },
        Body    = enc,
        timeout = req.timeout or 60,
    })
    if not resp.success then return resp end

    local dec = Utils.Decode(resp.body)
    if not dec then
        return { success = false, error = { code = "BAD_JSON", message = "Respuesta invalida." } }
    end
    if dec.error then
        return { success = false, error = {
            code = tostring(dec.error.code or "PROVIDER_ERROR"),
            message = dec.error.message or "Error del proveedor.",
        } }
    end

    local choice = dec.choices and dec.choices[1]
    local msg = choice and choice.message
    local content = msg and msg.content
    if type(content) ~= "string" then
        return { success = false, error = { code = "EMPTY", message = "Respuesta vacia." } }
    end

    return { success = true, content = content, model = dec.model or req.model, usage = dec.usage or {} }
end

BLADEX.OpenRouter = OpenRouter
return OpenRouter