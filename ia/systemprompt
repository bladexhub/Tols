return function(E)
local Logger, Events = E.Logger, E.Events
local SystemPrompt = { content = nil, loading = false, lastError = nil }
function SystemPrompt:Load(force)
    if self.loading then return false end
    if self.content and not force then return true end
    self.loading = true
    self.lastError = nil
    local ok, code = pcall(function() return game:HttpGet(E.SYSTEM_PROMPT_URL, true) end)
    self.loading = false
    if not ok or not code or code == "" then self.lastError = "No se pudo descargar el prompt remoto." Logger:Error("SystemPrompt: %s", self.lastError) return false end
    local loader = loadstring(code, "@SystemPrompt")
    if not loader then self.lastError = "Prompt remoto inválido (no compila)." Logger:Error("SystemPrompt: %s", self.lastError) return false end
    local env = setmetatable({}, { __index = _G }) pcall(function() setfenv(loader, env) end)
    local ok2, chunkResult = pcall(loader)
    if not ok2 then self.lastError = "Prompt remoto falló al ejecutarse." Logger:Error("SystemPrompt: %s", self.lastError) return false end
    local result = nil
    if type(chunkResult) == "string" and chunkResult ~= "" then result = chunkResult
    elseif type(env.SYSTEM_PROMPT) == "string" and env.SYSTEM_PROMPT ~= "" then result = env.SYSTEM_PROMPT end
    if type(result) ~= "string" or result == "" then self.lastError = "El prompt remoto no devolvió texto válido." Logger:Error("SystemPrompt: %s", self.lastError) return false end
    self.content = result
    Logger:Info("SystemPrompt cargado (%d chars).", #result)
    Events:Emit("SystemPromptLoaded", self.content)
    return true
end
function SystemPrompt:Get() return self.content end
E.SystemPrompt = SystemPrompt
return E
end
