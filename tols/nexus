-- loader url
local URL_LOADER = "https://raw.githubusercontent.com/BladexDevX/loader/refs/heads/main/BladexIconLoader"

-- http
local function fetch(url)
    local ok, res = pcall(game.HttpGet, game, url)
    if ok and type(res) == "string" and #res > 0 then
        return res
    end
    return nil
end

-- loader
local IconLoader = nil
pcall(function()
    local source = fetch(URL_LOADER)
    if not source then return end
    local fn = loadstring(source)
    if not fn then return end
    local ok, res = pcall(fn)
    if ok and type(res) == "table" then
        IconLoader = res
    end
end)

-- resolver icono
local function resolveIcon(name)
    if not name or name == "" then return nil end
    if IconLoader then
        local ok, id = pcall(IconLoader.Find, name)
        if ok and id then return id end
        local ok2, id2 = pcall(IconLoader.GetAny, {"lucide","solar","gravity","sfsymbols"}, name)
        if ok2 and id2 then return id2 end
    end
    return nil
end

