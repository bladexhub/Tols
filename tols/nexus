local Camera = workspace.CurrentCamera
local UIScale = Instance.new("UIScale")
UIScale.Name = "DeviceScale"
UIScale.Parent = ScreenGui

local BASE_WIDTH = 1280
local BASE_HEIGHT = 720
local MIN_SCALE = 0.72
local MAX_SCALE = 1.08

local function updateDeviceScale()
    Camera = workspace.CurrentCamera
    if not Camera then
        return
    end

    local viewport = Camera.ViewportSize
    local scaleX = viewport.X / BASE_WIDTH
    local scaleY = viewport.Y / BASE_HEIGHT
    local scale = math.min(scaleX, scaleY)

    UIScale.Scale = math.clamp(scale, MIN_SCALE, MAX_SCALE)
end

updateDeviceScale()

if Camera then
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateDeviceScale)
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    Camera = workspace.CurrentCamera
    updateDeviceScale()

    if Camera then
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateDeviceScale)
    end
end)

